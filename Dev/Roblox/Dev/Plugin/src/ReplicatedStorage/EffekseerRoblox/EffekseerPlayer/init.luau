--!nonstrict
-- Roblox runtime for Luau modules generated by Dev/Roblox/bin/effekseer-for-roblox.js.
-- Walks the converted node tree and dispatches each node to the renderer that
-- fits it best: particle emitters, per-particle quads, trails/beams, models,
-- child carriers, and sounds.

local Types = require(script:WaitForChild("Types"))
local Util = require(script:WaitForChild("Util"))
local Sampling = require(script:WaitForChild("Sampling"))
local Timing = require(script:WaitForChild("Timing"))
local Rig = require(script:WaitForChild("Rig"))
local Controller = require(script:WaitForChild("Controller"))
local Emitters = require(script:WaitForChild("Emitters"))
local Quads = require(script:WaitForChild("Quads"))
local TrailsBeams = require(script:WaitForChild("TrailsBeams"))
local Models = require(script:WaitForChild("Models"))
local Carriers = require(script:WaitForChild("Carriers"))
local Sound = require(script:WaitForChild("Sound"))

type EffectNode = Types.EffectNode
type EffectData = Types.EffectData
type PlayOptions = Types.PlayOptions

local componentMul = Util.componentMul
local rangeValue = Util.rangeValue
local inheritedScaleForNode = Sampling.inheritedScaleForNode
local nodeLocalDelay = Timing.nodeLocalDelay
local effectLoopEnabled = Timing.effectLoopEnabled
local nodeLifeFrames = Timing.nodeLifeFrames
local nodeCFrame = Rig.nodeCFrame
local resolveTarget = Rig.resolveTarget

local EffekseerPlayer = {}

local visitNodes

visitNodes = function(
	nodes: { EffectNode },
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
)
	local unitScale = options.unitScale or effect.unitScale or 0.01
	for _, node in nodes do
		Sound.scheduleSound(node, targetPart, effect, options, controller, inheritedDelaySeconds)
		local spritePartsHandled = Quads.scheduleSpriteParts(
			node,
			targetPart,
			rootCFrame,
			effect,
			options,
			controller,
			parentScale,
			inheritedDelaySeconds,
			visitNodes
		)
		local emitter =
			Emitters.createParticleEmitter(node, targetPart, rootCFrame, effect, options, parentScale, controller)
		if emitter then
			Emitters.scheduleEmitter(node, emitter, effect, options, controller, parentScale, inheritedDelaySeconds)
		end
		if not spritePartsHandled then
			local trailHandled = TrailsBeams.scheduleTrails(
				node,
				targetPart,
				rootCFrame,
				effect,
				options,
				controller,
				parentScale,
				inheritedDelaySeconds
			)
			if not trailHandled then
				local beam =
					TrailsBeams.createBeam(node, targetPart, rootCFrame, effect, options, parentScale, controller)
				if beam then
					TrailsBeams.scheduleBeam(node, beam, effect, options, controller, inheritedDelaySeconds)
				end
			end
			local model =
				Models.createModelVisual(node, targetPart, rootCFrame, effect, options, parentScale, controller)
			if model then
				Models.scheduleModelPart(
					node,
					model,
					targetPart,
					rootCFrame,
					effect,
					options,
					controller,
					parentScale,
					inheritedDelaySeconds
				)
			end
		end
		if not spritePartsHandled then
			local carried = Carriers.scheduleChildCarriers(
				node,
				targetPart,
				rootCFrame,
				effect,
				options,
				controller,
				parentScale,
				inheritedDelaySeconds,
				visitNodes
			)
			if not carried then
				local childScale = componentMul(parentScale, inheritedScaleForNode(node))
				visitNodes(
					node.children or {},
					targetPart,
					nodeCFrame(node, rootCFrame, unitScale, parentScale),
					effect,
					options,
					controller,
					childScale,
					(inheritedDelaySeconds or 0) + nodeLocalDelay(node, effect)
				)
			end
		end
	end
end

function EffekseerPlayer.play(effect: EffectData, target: Instance, options: PlayOptions?)
	local playOptions: PlayOptions = options or {}

	local targetPart, rootCFrame = resolveTarget(target)
	if playOptions.hideTarget == true then
		targetPart.Transparency = 1
	end

	local controller = Controller.new()

	visitNodes(effect.nodes, targetPart, rootCFrame, effect, playOptions, controller, Vector3.new(1, 1, 1), 0)

	-- autoDestroy would cut a looping effect off after its first cycle, so it only
	-- applies when the effect is not looping.
	if playOptions.autoDestroy and not effectLoopEnabled(effect, playOptions) then
		local longest = 0
		local frameRate = effect.frameRate or 60
		local function scan(nodes: { EffectNode }, inheritedOffset: number)
			for _, node in nodes do
				local offset = inheritedOffset + rangeValue(node.generation.offset, "max", 0) / frameRate
				local generation = if node.generation.max == 0
					then 0
					else (node.generation.max or 1) * rangeValue(node.generation.time, "max", 1) / frameRate
				local life = nodeLifeFrames(node, effect, "max") / frameRate
				longest = math.max(longest, offset + generation + life)
				-- Children spawn per parent instance, so the last child can start as
				-- late as the end of the parent's generation window.
				scan(node.children or {}, offset + generation)
			end
		end
		scan(effect.nodes, 0)
		task.delay(longest, function()
			if controller._alive then
				controller:Destroy()
			end
		end)
	end

	return controller
end

return EffekseerPlayer
