local function safeSet(instance: Instance, property: string, value)
	pcall(function()
		(instance :: any)[property] = value
	end)
end

local function assetMapValue(assetMap: { [string]: any }, assetPath: string, prefix: string?): any
	local mapPrefix = prefix or ""
	local direct = assetMap[mapPrefix .. assetPath]
	if direct and direct ~= "" then
		return direct
	end

	local basename = string.match(assetPath, "[^/\\]+$")
	if basename then
		local named = assetMap[mapPrefix .. basename]
		if named and named ~= "" then
			return named
		end

		local textureNamed = assetMap[mapPrefix .. "Texture/" .. basename]
		if textureNamed and textureNamed ~= "" then
			return textureNamed
		end

		local modelNamed = assetMap[mapPrefix .. "Model/" .. basename]
		if modelNamed and modelNamed ~= "" then
			return modelNamed
		end
	end

	local lowered = string.lower(assetPath)
	local lowerDirect = assetMap[mapPrefix .. lowered]
	if lowerDirect and lowerDirect ~= "" then
		return lowerDirect
	end

	if basename then
		local lowerBasename = string.lower(basename)
		local lowerNamed = assetMap[mapPrefix .. lowerBasename]
		if lowerNamed and lowerNamed ~= "" then
			return lowerNamed
		end

		local lowerTextureNamed = assetMap[mapPrefix .. "texture/" .. lowerBasename]
		if lowerTextureNamed and lowerTextureNamed ~= "" then
			return lowerTextureNamed
		end

		local lowerModelNamed = assetMap[mapPrefix .. "model/" .. lowerBasename]
		if lowerModelNamed and lowerModelNamed ~= "" then
			return lowerModelNamed
		end
	end

	return nil
end

local function rangeValue(range: RangePayload?, key: string, fallback: number): number
	if range == nil then
		return fallback
	end

	local value = (range :: any)[key]
	if typeof(value) == "number" then
		return value
	end

	if typeof(range.center) == "number" then
		return range.center
	end

	return fallback
end

local function vectorPayload(value: VectorPayload?, fallback: Vector3?): Vector3
	local fallbackVector = fallback or Vector3.zero
	if value == nil then
		return fallbackVector
	end
	return Vector3.new(value.x or fallbackVector.X, value.y or fallbackVector.Y, value.z or fallbackVector.Z)
end

local function componentMul(a: Vector3, b: Vector3): Vector3
	return Vector3.new(a.X * b.X, a.Y * b.Y, a.Z * b.Z)
end

local function averageXYVector(value: Vector3): number
	return (math.abs(value.X) + math.abs(value.Y)) * 0.5
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function evaluateKeysVector(keys: BakedKeys, frame: number): Vector3
	local frames = keys.frames
	local values = keys.values
	local count = #frames
	if count == 0 then
		return Vector3.zero
	end
	if frame <= frames[1] then
		local first = values[1]
		return Vector3.new(first.x or 0, first.y or 0, first.z or 0)
	end
	if frame >= frames[count] then
		local last = values[count]
		return Vector3.new(last.x or 0, last.y or 0, last.z or 0)
	end
	for index = 2, count do
		if frame <= frames[index] then
			local span = frames[index] - frames[index - 1]
			local t = if span > 1e-9 then (frame - frames[index - 1]) / span else 0
			local a = values[index - 1]
			local b = values[index]
			return Vector3.new(lerp(a.x or 0, b.x or 0, t), lerp(a.y or 0, b.y or 0, t), lerp(a.z or 0, b.z or 0, t))
		end
	end
	local last = values[count]
	return Vector3.new(last.x or 0, last.y or 0, last.z or 0)
end

local function alignYToDirection(direction: Vector3): CFrame
	if direction.Magnitude < 1e-6 then
		return CFrame.identity
	end
	local up = direction.Unit
	local reference = if math.abs(up:Dot(Vector3.xAxis)) > 0.99 then Vector3.zAxis else Vector3.xAxis
	local right = up:Cross(reference).Unit
	return CFrame.fromMatrix(Vector3.zero, right, up)
end

local function uvRectAt(uv: UVPayload, ageFrames: number): (Vector2?, Vector2?)
	local sizeX = uv.size and uv.size.x or 0
	local sizeY = uv.size and uv.size.y or 0
	if sizeX <= 0 or sizeY <= 0 then
		return nil, nil
	end
	local startX = uv.start and uv.start.x or 0
	local startY = uv.start and uv.start.y or 0

	if uv.type == 2 and uv.animation then
		local animation = uv.animation
		local total = math.max(1, animation.countX * animation.countY)
		local frameIndex = math.floor(ageFrames / math.max(1, animation.frameLength)) + (animation.startSheet or 0)
		if animation.loopType == 1 then
			frameIndex = frameIndex % total
		elseif animation.loopType == 2 then
			local cycle = frameIndex % (2 * total)
			frameIndex = if cycle < total then cycle else 2 * total - 1 - cycle
		else
			frameIndex = math.clamp(frameIndex, 0, total - 1)
		end
		local column = frameIndex % animation.countX
		local row = math.floor(frameIndex / animation.countX)
		return Vector2.new(startX + column * sizeX, startY + row * sizeY), Vector2.new(sizeX, sizeY)
	end

	if uv.type == 3 and uv.scroll then
		local speed = uv.scroll.speed
		-- Wrap by the rect size so full-texture scrolls repeat like Effekseer's Repeat wrap mode.
		local offsetX = (startX + (speed.x or 0) * ageFrames) % math.max(1, sizeX)
		local offsetY = (startY + (speed.y or 0) * ageFrames) % math.max(1, sizeY)
		return Vector2.new(offsetX, offsetY), Vector2.new(sizeX, sizeY)
	end

	return Vector2.new(startX, startY), Vector2.new(sizeX, sizeY)
end

local function sphericalDirection(polarDegrees: number, azimuthDegrees: number): Vector3
	local polar = math.rad(polarDegrees)
	local azimuth = math.rad(azimuthDegrees)
	return Vector3.new(math.cos(polar) * math.cos(azimuth), math.sin(polar), math.cos(polar) * math.sin(azimuth))
end

local function randomRangePayload(range: RangePayload?, fallback: number): number
	local minValue = rangeValue(range, "min", fallback)
	local maxValue = rangeValue(range, "max", fallback)
	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end
	return minValue + (maxValue - minValue) * math.random()
end

local function randomVectorPayload(range, fallback: Vector3?): Vector3
	local fallbackVector = fallback or Vector3.zero
	if not range then
		return fallbackVector
	end
	local function axisValue(axis: string, fallbackValue: number): number
		local minValue = (range.min and (range.min :: any)[axis]) or fallbackValue
		local maxValue = (range.max and (range.max :: any)[axis]) or fallbackValue
		if minValue > maxValue then
			minValue, maxValue = maxValue, minValue
		end
		return minValue + (maxValue - minValue) * math.random()
	end
	return Vector3.new(
		axisValue("x", fallbackVector.X),
		axisValue("y", fallbackVector.Y),
		axisValue("z", fallbackVector.Z)
	)
end

-- Local-space spawn offset (in Effekseer units) for the generation-location shapes.
-- `index` is the 1-based particle index so Order/ReverseOrder placements are deterministic.
local function spawnOffsetForIndex(node: EffectNode, index: number): Vector3
	local spawn = node.spawn
	if not spawn then
		return Vector3.zero
	end

	if spawn.type == 1 and spawn.sphere then
		local sphere = spawn.sphere
		local radius = randomRangePayload(sphere.radius, 0)
		local polar = randomRangePayload(sphere.rotationX, 0)
		local azimuth = randomRangePayload(sphere.rotationY, 0)
		return sphericalDirection(polar, azimuth) * radius
	end

	if spawn.type == 3 and spawn.circle then
		local circle = spawn.circle
		local division = math.max(1, circle.division or 8)
		local t
		if circle.order == 1 then
			t = ((index - 1) % division) / division
		elseif circle.order == 2 then
			t = 1 - ((index - 1) % division) / division
		else
			t = math.random()
		end
		local angleStart = randomRangePayload(circle.angleStart, 0)
		local angleEnd = randomRangePayload(circle.angleEnd, 360)
		local noise = if circle.angleNoise then randomRangePayload(circle.angleNoise, 0) else 0
		local angle = math.rad(angleStart + (angleEnd - angleStart) * t + noise)
		local radius = randomRangePayload(circle.radius, 0)
		local cosValue = math.cos(angle) * radius
		local sinValue = math.sin(angle) * radius
		if circle.axis == 0 then
			return Vector3.new(0, cosValue, sinValue)
		elseif circle.axis == 1 then
			return Vector3.new(cosValue, 0, sinValue)
		end
		return Vector3.new(cosValue, sinValue, 0)
	end

	if spawn.type == 4 and spawn.line then
		local line = spawn.line
		local division = math.max(1, line.division or 8)
		local t
		if line.order == 1 then
			t = if division > 1 then ((index - 1) % division) / (division - 1) else 0
		else
			t = math.random()
		end
		local fromPosition = randomVectorPayload(line.from, Vector3.zero)
		local toPosition = randomVectorPayload(line.to, Vector3.zero)
		local noise = if line.noise then randomRangePayload(line.noise, 0) else 0
		local along = toPosition - fromPosition
		local base = fromPosition + along * t
		if noise ~= 0 and along.Magnitude > 1e-6 then
			base += along.Unit * noise
		end
		return base
	end

	return Vector3.zero
end

local function hasSpawnShape(node: EffectNode): boolean
	local spawn = node.spawn
	return spawn ~= nil and (spawn.type == 1 or spawn.type == 3 or spawn.type == 4)
end

local function randomBetween(minValue: number, maxValue: number): number
	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end
	return minValue + (maxValue - minValue) * math.random()
end

local function numberRange(minValue: number, maxValue: number): NumberRange
	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end

	return NumberRange.new(minValue, maxValue)
end

local function color3(color: { r: number, g: number, b: number }): Color3
	return Color3.fromRGB(color.r or 255, color.g or 255, color.b or 255)
end

local function colorSequence(node: EffectNode): ColorSequence
	if node.colorOverLife then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, color3(node.colorOverLife.start)),
			ColorSequenceKeypoint.new(1, color3(node.colorOverLife.finish)),
		})
	end

	return ColorSequence.new(color3(node.color))
end

-- NumberSequence requires strictly increasing keypoint times ending exactly at 1.
local function sanitizedSequence(entries: { { time: number, value: number, envelope: number? } }): NumberSequence
	table.sort(entries, function(left, right)
		return left.time < right.time
	end)
	local keypoints = {}
	local previousTime = -1
	for index, entry in entries do
		local time = math.clamp(entry.time, 0, 1)
		if index == #entries then
			time = 1
		end
		if time <= previousTime then
			time = math.min(1, previousTime + 1e-3)
		end
		if time > previousTime then
			table.insert(
				keypoints,
				NumberSequenceKeypoint.new(time, math.clamp(entry.value, 0, 1e9), entry.envelope or 0)
			)
			previousTime = time
		end
	end
	if #keypoints == 0 then
		return NumberSequence.new(0)
	end
	if keypoints[1].Time > 0 then
		table.insert(keypoints, 1, NumberSequenceKeypoint.new(0, keypoints[1].Value, keypoints[1].Envelope))
	end
	if keypoints[#keypoints].Time < 1 then
		local last = keypoints[#keypoints]
		table.insert(keypoints, NumberSequenceKeypoint.new(1, last.Value, last.Envelope))
	end
	return NumberSequence.new(keypoints)
end

local function transparencySequence(node: EffectNode, lifeSeconds: number, frameRate: number): NumberSequence
	local startColor = if node.colorOverLife then node.colorOverLife.start else node.color
	local finishColor = if node.colorOverLife then node.colorOverLife.finish else node.color
	local startTransparency = 1 - math.clamp((startColor.a or 255) / 255, 0, 1)
	local finishTransparency = 1 - math.clamp((finishColor.a or 255) / 255, 0, 1)
	local fadeIn = math.max(0, node.fadeIn or 0)
	local fadeOut = math.max(0, node.fadeOut or 0)
	local duration = math.max(1 / frameRate, lifeSeconds)

	if fadeIn <= 0 and fadeOut <= 0 and startTransparency == finishTransparency then
		return NumberSequence.new(startTransparency)
	end

	local fadeInT = math.clamp((fadeIn / frameRate) / duration, 0, 0.98)
	local fadeOutT = math.clamp(1 - (fadeOut / frameRate) / duration, fadeInT, 1)

	local entries = {
		{ time = 0, value = if fadeIn > 0 then 1 else startTransparency },
	}

	if fadeIn > 0 then
		table.insert(entries, { time = fadeInT, value = startTransparency })
	end

	if fadeOut > 0 then
		table.insert(entries, { time = fadeOutT, value = finishTransparency })
		table.insert(entries, { time = 1, value = 1 })
	elseif startTransparency ~= finishTransparency then
		table.insert(entries, { time = 1, value = finishTransparency })
	else
		table.insert(entries, { time = 1, value = startTransparency })
	end

	return sanitizedSequence(entries)
end

local function blendLightEmission(node: EffectNode): number
	return if node.alphaBlend == 2 then 1 else 0
end

local function sizeVectorAt(node: EffectNode, t: number): Vector3
	local size = node.transform.size
	local startVector = vectorPayload(size.startVector, Vector3.new(size.start or 1, size.start or 1, size.start or 1))
	local finishFallback =
		Vector3.new(size.finish or size.start or 1, size.finish or size.start or 1, size.finish or size.start or 1)
	local finishVector = vectorPayload(size.finishVector, finishFallback)
	return Vector3.new(
		lerp(startVector.X, finishVector.X, t),
		lerp(startVector.Y, finishVector.Y, t),
		lerp(startVector.Z, finishVector.Z, t)
	)
end

local function ringDiameterAt(node: EffectNode, t: number): number
	local ring = if node.visual then node.visual.ring else nil
	if not ring then
		return 1
	end
	local startRadius = ring.outerRadius or 1
	local finishRadius = ring.outerRadiusFinish or startRadius
	return math.max(0.01, lerp(startRadius, finishRadius, t) * 2)
end

local function inheritedScaleForNode(node: EffectNode): Vector3
	local scale = sizeVectorAt(node, 0)
	return Vector3.new(
		math.max(0.001, math.abs(scale.X)),
		math.max(0.001, math.abs(scale.Y)),
		math.max(0.001, math.abs(scale.Z))
	)
end

local function visualSizeMultiplierAt(node: EffectNode, t: number): number
	if node.rendererType == "Ring" then
		return ringDiameterAt(node, t)
	end
	return 1
end

local function sizeSequence(
	node: EffectNode,
	unitScale: number,
	particleSizeScale: number,
	parentScale: Vector3
): NumberSequence
	local size = node.transform.size
	local scale = unitScale * particleSizeScale
	local envelope = math.max(0, (size.envelope or 0) * scale)

	local scaleKeys = size.scaleKeys
	if scaleKeys and #scaleKeys.frames > 1 then
		local lastFrame = math.max(1, scaleKeys.frames[#scaleKeys.frames])
		local entries = {}
		for index, frame in scaleKeys.frames do
			local t = math.clamp(frame / lastFrame, 0, 1)
			local value = scaleKeys.values[index]
			local vector = componentMul(Vector3.new(value.x or 1, value.y or 1, value.z or 1), parentScale)
			table.insert(entries, {
				time = t,
				value = math.max(0.01, averageXYVector(vector) * scale * visualSizeMultiplierAt(node, t)),
				envelope = envelope,
			})
		end
		return sanitizedSequence(entries)
	end

	local startSize = math.max(
		0.01,
		averageXYVector(componentMul(sizeVectorAt(node, 0), parentScale)) * scale * visualSizeMultiplierAt(node, 0)
	)
	local finishSize = math.max(
		0.01,
		averageXYVector(componentMul(sizeVectorAt(node, 1), parentScale)) * scale * visualSizeMultiplierAt(node, 1)
	)

	if math.abs(startSize - finishSize) < 1e-5 then
		if envelope <= 0 then
			return NumberSequence.new(startSize)
		end

		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, startSize, envelope),
			NumberSequenceKeypoint.new(1, startSize, envelope),
		})
	end

	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, startSize, envelope),
		NumberSequenceKeypoint.new(1, finishSize, envelope),
	})
end

local function resolveTarget(target: Instance): (BasePart, CFrame)
	if target:IsA("Attachment") then
		local parent = target.Parent
		assert(parent and parent:IsA("BasePart"), "Effekseer target Attachment must be parented to a BasePart")
		return parent, target.CFrame
	end

	if target:IsA("BasePart") then
		return target, CFrame.identity
	end

	if target:IsA("Model") then
		local primaryPart = target.PrimaryPart
		assert(primaryPart ~= nil, "Effekseer target Model must have PrimaryPart set")
		return primaryPart, CFrame.identity
	end

	error("Effekseer target must be a BasePart, Attachment, or Model")
end

local Controller = {}
Controller.__index = Controller

function Controller:Stop()
	self._alive = false
	for _, emitter in self._emitters do
		if emitter.Parent then
			emitter.Enabled = false
		end
	end
	for _, beam in self._beams do
		if beam.Parent then
			beam.Enabled = false
		end
	end
	for _, part in self._parts do
		if part.Parent then
			part.Transparency = 1
			for _, child in part:GetDescendants() do
				if child:IsA("Decal") then
					child.Transparency = 1
				elseif child:IsA("ImageLabel") then
					child.ImageTransparency = 1
				end
			end
		end
	end
end

function Controller:Destroy()
	self:Stop()
	for _, instance in self._instances do
		if instance.Parent then
			instance:Destroy()
		end
	end
	table.clear(self._instances)
	table.clear(self._emitters)
	table.clear(self._beams)
	table.clear(self._parts)
end

local function additivePreviewTextureForNode(node: EffectNode, options: PlayOptions): any
	if
		options.useAdditivePreviewTexture ~= true
		or node.alphaBlend ~= 2
		or not options.assetMap
		or not node.texturePath
	then
		return nil
	end

	return assetMapValue(options.assetMap, node.texturePath, "additive:")
end

local function textureForNode(
	node: EffectNode,
	options: PlayOptions,
	fallback: string?,
	preferAdditivePreview: boolean?
): any
	if preferAdditivePreview then
		local additiveTexture = additivePreviewTextureForNode(node, options)
		if additiveTexture then
			return additiveTexture
		end
	end

	if options.assetMap and node.texturePath then
		local mappedTexture = assetMapValue(options.assetMap, node.texturePath, nil)
		if mappedTexture then
			return mappedTexture
		end
	end

	local texture = node.texture
	return texture or fallback or ""
end

local function modelAssetForNode(node: EffectNode, options: PlayOptions): string?
	local model = if node.visual then node.visual.model else nil
	if not model then
		return nil
	end

	if options.assetMap and model.path and model.path ~= "" then
		local mappedModel = assetMapValue(options.assetMap, model.path, nil)
		if mappedModel then
			return mappedModel
		end
	end

	if model.asset and model.asset ~= "" then
		return model.asset
	end

	return nil
end

local function enumValue(enumType, name: string)
	local ok, value = pcall(function()
		return (enumType :: any)[name]
	end)
	if ok then
		return value
	end
	return nil
end

local function billboardMode(node: EffectNode): number
	local visual = node.visual
	local sprite = if visual then visual.sprite else nil
	local ring = if visual then visual.ring else nil
	local billboard = if sprite then sprite.billboard elseif ring then ring.billboard else nil
	return billboard or 0
end

local function particleOrientationForNode(node: EffectNode)
	local billboard = billboardMode(node)
	if billboard == BILLBOARD.YAxisFixed then
		return enumValue(Enum.ParticleOrientation, "FacingCameraWorldUp") or Enum.ParticleOrientation.FacingCamera
	end
	if billboard == BILLBOARD.DirectionalBillboard then
		return enumValue(Enum.ParticleOrientation, "VelocityParallel") or Enum.ParticleOrientation.FacingCamera
	end
	return Enum.ParticleOrientation.FacingCamera
end

local function rotationZXY(rotation: VectorPayload?): CFrame
	if not rotation then
		return CFrame.identity
	end

	local x = math.rad(rotation.x or 0)
	local y = math.rad(rotation.y or 0)
	local z = math.rad(rotation.z or 0)
	-- Effekseer evaluates Euler rotations as RotationZXY(z, x, y).
	return CFrame.Angles(0, y, 0) * CFrame.Angles(x, 0, 0) * CFrame.Angles(0, 0, z)
end

local function nodeCFrame(node: EffectNode, rootCFrame: CFrame, unitScale: number, parentScale: Vector3?): CFrame
	local rotation3 = node.transform.rotation.rotation3
	local rotation = if rotation3
		then rotation3.center
		else { x = 0, y = 0, z = rangeValue(node.transform.rotation.rotation, "center", 0) }
	local inheritedScale = parentScale or Vector3.one
	local localPosition = componentMul(vectorPayload(node.transform.position, Vector3.zero), inheritedScale) * unitScale
	return rootCFrame * CFrame.new(localPosition) * rotationZXY(rotation)
end

local function createAttachment(targetPart: BasePart, name: string, cframe: CFrame, controller): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.CFrame = cframe
	attachment.Parent = targetPart
	table.insert(controller._instances, attachment)
	return attachment
end

local function createHostPart(targetPart: BasePart, name: string, cframe: CFrame, size: Vector3, controller): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Transparency = 1
	part.Size = size
	part.CFrame = targetPart.CFrame * cframe
	part.Parent = targetPart

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = targetPart
	weld.Part1 = part
	weld.Parent = part

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)
	return part
end

-- Life in frames; "delete when life expires = false" nodes live for the whole effect timeline instead.
local function nodeLifeFrames(node: EffectNode, effect: EffectData, key: string): number
	local frames = rangeValue(node.life, key, 100)
	if node.life.infinite then
		local durationFrames = effect.durationFrames or 0
		if durationFrames <= 0 then
			durationFrames = math.max(0, (effect.endFrame or 0) - (effect.startFrame or 0))
		end
		frames = math.max(frames, if durationFrames > 0 then durationFrames else 600)
	end
	return frames
end

local function visualTiming(node: EffectNode, effect: EffectData, options: PlayOptions, inheritedDelaySeconds: number?)
	local frameRate = effect.frameRate or 60
	local maxGeneration = node.generation.max or 1
	local generationFrames = math.max(0.001, rangeValue(node.generation.time, "center", 1))
	local generationSeconds = generationFrames / frameRate
	local offsetSeconds = (inheritedDelaySeconds or 0)
		+ math.max(0, rangeValue(node.generation.offset, "center", 0) / frameRate)
	local nodeInfinite = maxGeneration == 0
	local lifeMax = math.max(1 / frameRate, nodeLifeFrames(node, effect, "max") / frameRate)
	local duration = if nodeInfinite
		then 0
		else math.max(lifeMax, math.max(1, maxGeneration) * generationSeconds + lifeMax)
	return frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite, lifeMax, duration
end

local function nodeLocalDelay(node: EffectNode, effect: EffectData): number
	local frameRate = effect.frameRate or 60
	return math.max(0, rangeValue(node.generation.offset, "center", 0) / frameRate)
end

local function effectLoopEnabled(effect: EffectData, options: PlayOptions): boolean
	return options.loop == true or (options.loop == nil and effect.isLoop == true)
end

local function effectCycleSeconds(effect: EffectData, frameRate: number): number?
	local durationFrames = effect.durationFrames
	if not durationFrames or durationFrames <= 0 then
		durationFrames = math.max(0, (effect.endFrame or 0) - (effect.startFrame or 0))
	end
	if durationFrames and durationFrames > 0 then
		return durationFrames / frameRate
	end
	return nil
end

local function repeatEveryCycle(controller, instance: Instance, offsetSeconds: number, cycleSeconds: number?, callback)
	if cycleSeconds and cycleSeconds > 0 then
		local cycleOffset = offsetSeconds % cycleSeconds
		task.spawn(function()
			task.wait(cycleOffset)
			while controller._alive and instance.Parent do
				callback(cycleOffset, cycleSeconds)
				task.wait(cycleSeconds)
			end
		end)
		return
	end

	task.delay(offsetSeconds, function()
		if controller._alive and instance.Parent then
			callback(offsetSeconds, nil)
		end
	end)
end

local function scheduleBeam(
	node: EffectNode,
	beam: Beam,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local frameRate, _, _, offsetSeconds, nodeInfinite, _, duration =
		visualTiming(node, effect, options, inheritedDelaySeconds)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil

	repeatEveryCycle(
		controller,
		beam,
		offsetSeconds,
		cycleSeconds,
		function(cycleOffset: number, activeCycleSeconds: number?)
			if not controller._alive or not beam.Parent then
				return
			end
			beam.Enabled = true

			local visibleSeconds = duration
			if nodeInfinite and activeCycleSeconds then
				visibleSeconds = math.max(0.03, activeCycleSeconds - cycleOffset)
			end
			if not nodeInfinite or activeCycleSeconds then
				task.delay(visibleSeconds, function()
					if beam.Parent then
						beam.Enabled = false
					end
				end)
			end
		end
	)
end

local function disableEmitterAfter(emitter: ParticleEmitter, delaySeconds: number)
	task.delay(delaySeconds, function()
		if emitter.Parent then
			emitter.Enabled = false
			emitter.Rate = 0
		end
	end)
end

local function emitBurst(emitter: ParticleEmitter, count: number, generationSeconds: number, controller)
	for index = 1, count do
		task.delay((index - 1) * generationSeconds, function()
			if not controller._alive or not emitter.Parent then
				return
			end
			emitter:Emit(1)
		end)
	end
end

local function hasSpawnPositionRange(node: EffectNode): boolean
	local range = node.transform.positionRange
	if not range then
		return false
	end

	for _, axis in { "x", "y", "z" } do
		local minValue = (range.min :: any)[axis] or 0
		local maxValue = (range.max :: any)[axis] or 0
		local centerValue = (range.center :: any)[axis] or 0
		if math.abs(minValue - centerValue) > 1e-6 or math.abs(maxValue - centerValue) > 1e-6 then
			return true
		end
	end

	return false
end

local function spawnVolumeSize(node: EffectNode, unitScale: number, parentScale: Vector3): Vector3
	local range = node.transform.positionRange
	if not range then
		return Vector3.new(0.05, 0.05, 0.05)
	end

	return Vector3.new(
		math.max(0.05, math.abs((range.max.x or 0) - (range.min.x or 0)) * math.abs(parentScale.X) * unitScale),
		math.max(0.05, math.abs((range.max.y or 0) - (range.min.y or 0)) * math.abs(parentScale.Y) * unitScale),
		math.max(0.05, math.abs((range.max.z or 0) - (range.min.z or 0)) * math.abs(parentScale.Z) * unitScale)
	)
end

local function randomRangeOffset(node: EffectNode): Vector3
	local range = node.transform.positionRange
	if not range then
		return Vector3.zero
	end

	local center = range.center
	return Vector3.new(
		randomBetween(range.min.x or 0, range.max.x or 0) - (center.x or 0),
		randomBetween(range.min.y or 0, range.max.y or 0) - (center.y or 0),
		randomBetween(range.min.z or 0, range.max.z or 0) - (center.z or 0)
	)
end

local function emitBurstForNode(
	node: EffectNode,
	emitter: ParticleEmitter,
	count: number,
	generationSeconds: number,
	controller,
	baseCFrame: CFrame,
	unitScale: number,
	parentScale: Vector3
)
	local attachment = emitter.Parent
	local wantsOffsets = hasSpawnShape(node) or hasSpawnPositionRange(node)
	if not attachment or not attachment:IsA("Attachment") or not wantsOffsets then
		emitBurst(emitter, count, generationSeconds, controller)
		return
	end

	for index = 1, count do
		task.delay((index - 1) * generationSeconds, function()
			if not controller._alive or not emitter.Parent or not attachment.Parent then
				return
			end
			local offset = spawnOffsetForIndex(node, index) + randomRangeOffset(node)
			attachment.CFrame = baseCFrame * CFrame.new(componentMul(offset, parentScale) * unitScale)
			emitter:Emit(1)
			attachment.CFrame = baseCFrame
		end)
	end
end

local function scheduleRateWindow(
	emitter: ParticleEmitter,
	rate: number,
	durationSeconds: number?,
	controller,
	cycleOffset: number?,
	cycleSeconds: number?
)
	if not controller._alive or not emitter.Parent then
		return
	end
	emitter.Rate = rate
	emitter.Enabled = true

	if durationSeconds then
		disableEmitterAfter(emitter, durationSeconds)
	elseif cycleSeconds then
		disableEmitterAfter(emitter, math.max(0.03, cycleSeconds - (cycleOffset or 0)))
	end
end

local function particle2DRotationEnabled(node: EffectNode): boolean
	local billboard = billboardMode(node)
	return node.rendererType == "Sprite" and billboard == BILLBOARD.RotatedBillboard
end

local function flipbookMappable(node: EffectNode): boolean
	local uv = node.uv
	if not uv or uv.type ~= 2 or not uv.animation then
		return false
	end
	local animation = uv.animation
	if animation.countX ~= animation.countY then
		return false
	end
	if animation.countX ~= 2 and animation.countX ~= 4 and animation.countX ~= 8 then
		return false
	end
	if math.abs(uv.start.x or 0) > 1e-6 or math.abs(uv.start.y or 0) > 1e-6 then
		return false
	end
	return true
end

-- Square-grid sheet animations map straight onto Roblox particle flipbooks.
local function tryApplyFlipbook(emitter: ParticleEmitter, node: EffectNode, frameRate: number)
	if not flipbookMappable(node) then
		return
	end
	local uv = node.uv :: UVPayload
	local animation = uv.animation
	if not animation then
		return
	end
	local layout = enumValue(Enum.ParticleFlipbookLayout, "Grid" .. animation.countX .. "x" .. animation.countX)
	if not layout then
		return
	end
	local applied = pcall(function()
		(emitter :: any).FlipbookLayout = layout
	end)
	if not applied then
		return
	end
	safeSet(
		emitter,
		"FlipbookFramerate",
		NumberRange.new(math.clamp(frameRate / math.max(1, animation.frameLength), 0, 30))
	)
	local modeName = if animation.loopType == 0 then "OneShot" elseif animation.loopType == 2 then "PingPong" else "Loop"
	local mode = enumValue(Enum.ParticleFlipbookMode, modeName)
	if mode then
		safeSet(emitter, "FlipbookMode", mode)
	end
end

-- Cases a ParticleEmitter cannot represent: cropped or scrolling UVs, non-grid
-- sheet animations, and quads with a fixed world orientation.
local function needsQuadRendering(node: EffectNode): boolean
	if node.uv and not flipbookMappable(node) then
		return true
	end
	local billboard = billboardMode(node)
	if billboard == BILLBOARD.Fixed then
		return true
	end
	if node.rendererType == "Ring" and billboard == BILLBOARD.YAxisFixed then
		return true
	end
	return false
end

local function shouldUseSpriteParts(node: EffectNode, maxGeneration: number, options: PlayOptions): boolean
	if not node.rendered then
		return false
	end
	if node.rendererType ~= "Sprite" and node.rendererType ~= "Ring" then
		return false
	end
	if maxGeneration ~= 0 and maxGeneration > (options.burstTaskLimit or 200) then
		return false
	end
	if needsQuadRendering(node) then
		return true
	end
	if node.rendererType == "Ring" then
		return false
	end
	if node.alphaBlend == 2 and options.useAdditiveSpriteParts ~= true then
		return false
	end
	return true
end

local visitNodes

local function spriteGeometry(node: EffectNode)
	local sprite = if node.visual then node.visual.sprite else nil
	local position = if sprite then sprite.position else nil
	local center = if position then position.center else nil
	local size = if position then position.size else nil
	return {
		centerX = if center then center.x or 0 else 0,
		centerY = if center then center.y or 0 else 0,
		width = if size then math.max(0.01, size.x or 1) else 1,
		height = if size then math.max(0.01, size.y or 1) else 1,
	}
end

local function vectorPayloadCenter(range, fallback: Vector3?): Vector3
	local fallbackVector = fallback or Vector3.zero
	local center = if range then range.center else nil
	if not center then
		return fallbackVector
	end
	return Vector3.new(center.x or fallbackVector.X, center.y or fallbackVector.Y, center.z or fallbackVector.Z)
end

local function scaleStateVector(state, t: number, ageFrames: number): Vector3
	if state.mode == "keys" then
		return evaluateKeysVector(state.keys, ageFrames)
	end
	if state.mode == "pva" then
		return state.initial + state.velocity * ageFrames + state.acceleration * (0.5 * ageFrames * ageFrames)
	end
	if state.mode == "easing" then
		return Vector3.new(
			lerp(state.initial.X, state.finish.X, t),
			lerp(state.initial.Y, state.finish.Y, t),
			lerp(state.initial.Z, state.finish.Z, t)
		)
	end
	return sizeVectorAt(state.node, t)
end

local function sampleScaleState(node: EffectNode)
	local size = node.transform.size
	if size.scaleKeys and #size.scaleKeys.frames > 0 then
		return { mode = "keys", keys = size.scaleKeys }
	end
	if size.type == 1 and size.pva then
		return {
			mode = "pva",
			initial = randomVectorPayload(size.pva.scale, Vector3.new(1, 1, 1)),
			velocity = randomVectorPayload(size.pva.velocity, Vector3.zero),
			acceleration = randomVectorPayload(size.pva.acceleration, Vector3.zero),
		}
	end
	if size.type == 2 and size.easing then
		return {
			mode = "easing",
			initial = randomVectorPayload(
				size.easing.start,
				Vector3.new(size.start or 1, size.start or 1, size.start or 1)
			),
			finish = randomVectorPayload(
				size.easing.finish,
				Vector3.new(size.finish or 1, size.finish or 1, size.finish or 1)
			),
		}
	end
	if size.type == 3 and size.singlePva then
		local initial = randomRangePayload(size.singlePva.scale, size.start or 1)
		local velocity = randomRangePayload(size.singlePva.velocity, 0)
		local acceleration = randomRangePayload(size.singlePva.acceleration, 0)
		return {
			mode = "pva",
			initial = Vector3.new(initial, initial, initial),
			velocity = Vector3.new(velocity, velocity, velocity),
			acceleration = Vector3.new(acceleration, acceleration, acceleration),
		}
	end
	if size.type == 4 and size.singleEasing then
		local initial = randomRangePayload(size.singleEasing.start, size.start or 1)
		local finish = randomRangePayload(size.singleEasing.finish, size.finish or 1)
		return {
			mode = "easing",
			initial = Vector3.new(initial, initial, initial),
			finish = Vector3.new(finish, finish, finish),
		}
	end

	return { mode = "center", node = node }
end

local function color3At(node: EffectNode, t: number): Color3
	if node.colorOverLife then
		return Color3.new(
			lerp((node.colorOverLife.start.r or 255) / 255, (node.colorOverLife.finish.r or 255) / 255, t),
			lerp((node.colorOverLife.start.g or 255) / 255, (node.colorOverLife.finish.g or 255) / 255, t),
			lerp((node.colorOverLife.start.b or 255) / 255, (node.colorOverLife.finish.b or 255) / 255, t)
		)
	end

	return color3(node.color)
end

local function spriteTransparencyAt(
	node: EffectNode,
	ageSeconds: number,
	lifeSeconds: number,
	frameRate: number
): number
	local t = math.clamp(ageSeconds / math.max(lifeSeconds, 1 / frameRate), 0, 1)
	local startColor = if node.colorOverLife then node.colorOverLife.start else node.color
	local finishColor = if node.colorOverLife then node.colorOverLife.finish else node.color
	local startTransparency = 1 - math.clamp((startColor.a or 255) / 255, 0, 1)
	local finishTransparency = 1 - math.clamp((finishColor.a or 255) / 255, 0, 1)
	local transparency = lerp(startTransparency, finishTransparency, t)
	local fadeInSeconds = math.max(0, node.fadeIn or 0) / frameRate
	local fadeOutSeconds = math.max(0, node.fadeOut or 0) / frameRate

	if fadeInSeconds > 0 and ageSeconds < fadeInSeconds then
		local fadeT = math.clamp(ageSeconds / fadeInSeconds, 0, 1)
		transparency = lerp(1, transparency, fadeT)
	end
	if fadeOutSeconds > 0 and ageSeconds > lifeSeconds - fadeOutSeconds then
		local fadeT = math.clamp((ageSeconds - (lifeSeconds - fadeOutSeconds)) / fadeOutSeconds, 0, 1)
		transparency = lerp(transparency, 1, fadeT)
	end

	return transparency
end

local function billboardCFrame(baseCFrame: CFrame, billboard: number, direction: Vector3?): CFrame
	if billboard == BILLBOARD.Fixed then
		return baseCFrame
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return baseCFrame
	end

	local front = camera.CFrame.LookVector
	local up = Vector3.yAxis
	if billboard == BILLBOARD.YAxisFixed then
		up = baseCFrame.UpVector
	elseif billboard == BILLBOARD.DirectionalBillboard and direction and direction.Magnitude > 1e-6 then
		up = direction.Unit
	end

	local right = up:Cross(front)
	if right.Magnitude < 1e-6 then
		right = baseCFrame.RightVector
	else
		right = right.Unit
	end
	local correctedFront = right:Cross(up)
	if correctedFront.Magnitude < 1e-6 then
		correctedFront = front
	else
		correctedFront = correctedFront.Unit
	end

	return CFrame.fromMatrix(baseCFrame.Position, right, up.Unit, -correctedFront)
end

local function setSpriteVisualState(
	node: EffectNode,
	visual: Instance,
	visible: boolean,
	ageSeconds: number,
	lifeSeconds: number,
	frameRate: number
)
	if visible then
		local t = math.clamp(ageSeconds / math.max(lifeSeconds, 1 / frameRate), 0, 1)
		local color = color3At(node, t)
		local transparency = spriteTransparencyAt(node, ageSeconds, lifeSeconds, frameRate)
		if visual:IsA("Decal") then
			visual.Color3 = color
			visual.Transparency = transparency
		elseif visual:IsA("ImageLabel") then
			visual.ImageColor3 = color
			visual.ImageTransparency = transparency
		end
	else
		if visual:IsA("Decal") then
			visual.Transparency = 1
		elseif visual:IsA("ImageLabel") then
			visual.ImageTransparency = 1
		end
	end
end

local function createSpritePlane(
	node: EffectNode,
	targetPart: BasePart,
	worldCFrame: CFrame,
	texture,
	unitScale: number,
	particleSizeScale: number,
	parentScale: Vector3,
	initialScaleVector: Vector3,
	controller
): BasePart
	local geometry = spriteGeometry(node)
	local startSize = componentMul(initialScaleVector, parentScale)
		* unitScale
		* particleSizeScale
		* visualSizeMultiplierAt(node, 0)
	local startWidth = math.max(0.01, math.abs(startSize.X))
	local startHeight = math.max(0.01, math.abs(startSize.Y))
	local part = Instance.new("Part")
	part.Name = "Sprite_" .. tostring(node.name)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Transparency = 1
	part.Size = Vector3.new(geometry.width * startWidth, geometry.height * startHeight, 0.01)
	part.CFrame = worldCFrame * CFrame.new(geometry.centerX * startWidth, geometry.centerY * startHeight, 0)
	part.Parent = targetPart

	if texture == nil or texture == "" then
		-- Untextured Effekseer sprites render as plain colored quads.
		part.Material = if node.alphaBlend == 2 then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.Color = color3(node.color)
	elseif node.uv then
		-- ImageLabels support ImageRectOffset/Size, which Decals do not, so UV
		-- cropping, sheet animation, and scrolling all go through SurfaceGuis.
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local gui = Instance.new("SurfaceGui")
			gui.Name = "EffekseerSpriteGui"
			gui.Face = face
			gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
			gui.PixelsPerStud = 128
			gui.LightInfluence = 0
			gui.AlwaysOnTop = false
			safeSet(gui, "Brightness", if node.alphaBlend == 2 then 2 else 1)

			local image = Instance.new("ImageLabel")
			image.Name = "EffekseerSprite"
			image.BackgroundTransparency = 1
			image.BorderSizePixel = 0
			image.Size = UDim2.fromScale(1, 1)
			image.ImageColor3 = color3(node.color)
			image.ImageTransparency = 1
			if typeof(texture) == "Content" then
				local ok = pcall(function()
					(image :: any).ImageContent = texture
				end)
				if not ok then
					safeSet(image, "Image", texture)
				end
			else
				image.Image = texture
			end
			local offset, rectSize = uvRectAt(node.uv :: UVPayload, 0)
			if offset and rectSize then
				image.ImageRectOffset = offset
				image.ImageRectSize = rectSize
			end
			image.Parent = gui
			gui.Parent = part
		end
	else
		for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
			local decal = Instance.new("Decal")
			decal.Name = "EffekseerSprite"
			decal.Face = face
			decal.Color3 = color3(node.color)
			decal.Transparency = 1
			if typeof(texture) == "Content" then
				local ok = pcall(function()
					(decal :: any).ColorMapContent = texture
				end)
				if not ok then
					safeSet(decal, "TextureContent", texture)
				end
			else
				decal.Texture = texture
			end
			decal.Parent = part
		end
	end

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)
	return part
end

local function updateSpritePlane(
	node: EffectNode,
	part: BasePart,
	spawnRootCFrame: CFrame,
	billboard: number,
	initialPosition: Vector3,
	velocity: Vector3,
	acceleration: Vector3,
	initialRotation: Vector3,
	rotationSpeed: Vector3,
	lifeSeconds: number,
	frameRate: number,
	unitScale: number,
	particleSizeScale: number,
	parentScale: Vector3,
	scaleState,
	controller
)
	local geometry = spriteGeometry(node)
	local startClock = os.clock()
	local positionKeys = node.transform.positionKeys
	local rotationKeys = node.transform.rotation.rotationKeys
	local uv = node.uv
	local animatedUV = uv ~= nil and (uv.type == 2 or uv.type == 3)
	local hasVisualChildren = false
	for _, child in part:GetDescendants() do
		if child:IsA("Decal") or child:IsA("ImageLabel") then
			hasVisualChildren = true
			break
		end
	end

	while controller._alive and part.Parent do
		local ageSeconds = os.clock() - startClock
		if ageSeconds >= lifeSeconds then
			break
		end

		local ageFrames = ageSeconds * frameRate
		local t = math.clamp(ageSeconds / math.max(lifeSeconds, 1 / frameRate), 0, 1)
		local localPosition
		if positionKeys then
			localPosition = initialPosition
				+ evaluateKeysVector(positionKeys, ageFrames)
				+ acceleration * (0.5 * ageFrames * ageFrames)
		else
			localPosition = initialPosition + velocity * ageFrames + acceleration * (0.5 * ageFrames * ageFrames)
		end
		local rotation
		if rotationKeys then
			rotation = evaluateKeysVector(rotationKeys, ageFrames)
		else
			rotation = initialRotation + rotationSpeed * ageFrames
		end
		local baseCFrame = spawnRootCFrame
			* CFrame.new(localPosition * unitScale)
			* rotationZXY({ x = rotation.X, y = rotation.Y, z = rotation.Z })
		local orientedCFrame = billboardCFrame(baseCFrame, billboard, velocity)
		local scaleVector = componentMul(scaleStateVector(scaleState, t, ageFrames), parentScale)
			* unitScale
			* particleSizeScale
			* visualSizeMultiplierAt(node, t)
		local width = math.max(0.01, math.abs(scaleVector.X))
		local height = math.max(0.01, math.abs(scaleVector.Y))

		part.Size = Vector3.new(geometry.width * width, geometry.height * height, 0.01)
		part.CFrame = orientedCFrame * CFrame.new(geometry.centerX * width, geometry.centerY * height, 0)
		if hasVisualChildren then
			local rectOffset: Vector2? = nil
			local rectSize: Vector2? = nil
			if uv and animatedUV then
				rectOffset, rectSize = uvRectAt(uv, ageFrames)
			end
			for _, child in part:GetDescendants() do
				if child:IsA("Decal") or child:IsA("ImageLabel") then
					setSpriteVisualState(node, child, true, ageSeconds, lifeSeconds, frameRate)
					if rectOffset and rectSize and child:IsA("ImageLabel") then
						child.ImageRectOffset = rectOffset
						child.ImageRectSize = rectSize
					end
				end
			end
		else
			part.Color = color3At(node, t)
			part.Transparency = spriteTransparencyAt(node, ageSeconds, lifeSeconds, frameRate)
		end

		RunService.Heartbeat:Wait()
	end

	if part.Parent then
		part:Destroy()
	end
end

local function scheduleSpriteParts(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
): boolean
	if not node.rendered or (node.rendererType ~= "Sprite" and node.rendererType ~= "Ring") then
		return false
	end

	-- An empty texture is allowed: Effekseer renders untextured sprites as plain
	-- colored quads, and bailing out here would also silently drop the child nodes.
	local fallbackTexture = if node.rendererType == "Ring" then RING_FALLBACK_TEXTURE else nil
	local texture = textureForNode(node, options, fallbackTexture, true)

	local frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite, lifeMax =
		visualTiming(node, effect, options, inheritedDelaySeconds)
	if not shouldUseSpriteParts(node, maxGeneration, options) then
		return false
	end

	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local marker = Instance.new("Folder")
	marker.Name = "EffekseerSpriteParts_" .. tostring(node.id) .. "_" .. tostring(node.name)
	marker.Parent = targetPart
	table.insert(controller._instances, marker)

	local spawnCounter = 0
	local function spawnSpritePart(): boolean
		if not controller._alive or not marker.Parent or not targetPart.Parent then
			return false
		end

		spawnCounter += 1
		local spawnRootCFrame = targetPart.CFrame * rootCFrame
		-- Baked position keys already contain the spawn position at frame 0, so
		-- only the generation-location offset applies in that case.
		local baseOffset = if node.transform.positionKeys
			then Vector3.zero
			else randomVectorPayload(node.transform.positionRange, Vector3.zero)
		local initialPosition = componentMul(baseOffset + spawnOffsetForIndex(node, spawnCounter), parentScale)
		local velocity = componentMul(randomVectorPayload(node.transform.velocity, Vector3.zero), parentScale)
		local acceleration = componentMul(randomVectorPayload(node.transform.acceleration, Vector3.zero), parentScale)
		local initialRotation = randomVectorPayload(node.transform.rotation.rotation3, Vector3.zero)
		local rotationSpeed = randomVectorPayload(node.transform.rotation.speed3, Vector3.zero)
		local scaleState = sampleScaleState(node)
		local initialScaleVector = scaleStateVector(scaleState, 0, 0)
		local initialCFrame = spawnRootCFrame
			* CFrame.new(initialPosition * unitScale)
			* rotationZXY({ x = initialRotation.X, y = initialRotation.Y, z = initialRotation.Z })
		initialCFrame = billboardCFrame(initialCFrame, billboardMode(node), velocity)
		local part = createSpritePlane(
			node,
			targetPart,
			initialCFrame,
			texture,
			unitScale,
			particleSizeScale,
			parentScale,
			initialScaleVector,
			controller
		)
		if visitNodes and node.children and #node.children > 0 then
			visitNodes(
				node.children,
				part,
				CFrame.identity,
				effect,
				options,
				controller,
				componentMul(parentScale, inheritedScaleForNode(node)),
				(inheritedDelaySeconds or 0) + nodeLocalDelay(node, effect)
			)
		end
		task.spawn(function()
			updateSpritePlane(
				node,
				part,
				spawnRootCFrame,
				billboardMode(node),
				initialPosition,
				velocity,
				acceleration,
				initialRotation,
				rotationSpeed,
				lifeMax,
				frameRate,
				unitScale,
				particleSizeScale,
				parentScale,
				scaleState,
				controller
			)
		end)
		return true
	end

	repeatEveryCycle(
		controller,
		marker,
		offsetSeconds,
		cycleSeconds,
		function(cycleOffset: number, activeCycleSeconds: number?)
			if nodeInfinite then
				task.spawn(function()
					local startClock = os.clock()
					local activeSeconds = if activeCycleSeconds
						then math.max(0.03, activeCycleSeconds - (cycleOffset or 0))
						else nil
					while controller._alive and marker.Parent and targetPart.Parent do
						if activeSeconds and os.clock() - startClock >= activeSeconds then
							break
						end
						if not spawnSpritePart() then
							break
						end
						task.wait(generationSeconds)
					end
				end)
				return
			end

			for index = 1, math.max(0, maxGeneration) do
				task.delay((index - 1) * generationSeconds, spawnSpritePart)
			end
		end
	)

	return true
end

local function createParticleEmitter(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	parentScale: Vector3,
	controller
): ParticleEmitter?
	if not node.rendered then
		return nil
	end
	if shouldUseSpriteParts(node, node.generation.max or 1, options) then
		return nil
	end
	if node.rendererType == "Ribbon" or node.rendererType == "Track" or node.rendererType == "Model" then
		return nil
	end

	local hasTexturePath = node.texturePath ~= nil and node.texturePath ~= ""
	local fallbackTexture = if node.rendererType == "Ring" and not hasTexturePath then RING_FALLBACK_TEXTURE else nil
	local texture = textureForNode(node, options, fallbackTexture)
	if hasTexturePath and texture == "" then
		return nil
	end

	local frameRate = effect.frameRate or 60
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local speedScale = options.speedScale or 1
	local inheritedSpeedScale = averageXYVector(parentScale)
	local lifeMin = math.max(1 / frameRate, nodeLifeFrames(node, effect, "min") / frameRate)
	local lifeMax = math.max(lifeMin, nodeLifeFrames(node, effect, "max") / frameRate)

	local localCFrame = nodeCFrame(node, rootCFrame, unitScale, parentScale)
	local emissionDirection = NORMAL_IDS[node.transform.emissionDirection] or Enum.NormalId.Top
	local velocityDirection = componentMul(vectorPayloadCenter(node.transform.velocity, Vector3.zero), parentScale)
	if velocityDirection.Magnitude > 1e-6 then
		-- Orient the emitter so +Y matches the real velocity direction instead of
		-- rounding the launch direction to the nearest world axis.
		localCFrame = localCFrame * alignYToDirection(velocityDirection)
		emissionDirection = Enum.NormalId.Top
	end

	local spawn = node.spawn
	local orderedSpawn = false
	if spawn then
		if spawn.type == 3 and spawn.circle and spawn.circle.order ~= 0 then
			orderedSpawn = true
		elseif spawn.type == 4 and spawn.line and spawn.line.order ~= 0 then
			orderedSpawn = true
		end
	end
	-- Ordered placements teleport a point attachment per burst emit; random shapes
	-- use a host part with a matching emitter shape.
	local wantsAttachmentSpawn = orderedSpawn and (node.generation.max or 1) ~= 0

	local emitterParent: Instance? = nil
	local shapeKind: string? = nil
	local hostName = "EffekseerVolume_" .. tostring(node.id) .. "_" .. tostring(node.name)
	if spawn and hasSpawnShape(node) and not wantsAttachmentSpawn then
		local inheritedScale = averageXYVector(parentScale)
		if spawn.type == 1 and spawn.sphere then
			local diameter = math.max(0.05, rangeValue(spawn.sphere.radius, "max", 0) * 2 * inheritedScale * unitScale)
			emitterParent =
				createHostPart(targetPart, hostName, localCFrame, Vector3.new(diameter, diameter, diameter), controller)
			shapeKind = "sphere"
		elseif spawn.type == 3 and spawn.circle then
			local circle = spawn.circle
			local diameter = math.max(0.05, rangeValue(circle.radius, "max", 0) * 2 * inheritedScale * unitScale)
			local orientation = CFrame.identity
			if circle.axis == 2 then
				-- Roblox discs lie in the XZ plane; Effekseer's ZAxis circles lie in XY.
				orientation = CFrame.Angles(math.pi / 2, 0, 0)
			elseif circle.axis == 0 then
				orientation = CFrame.Angles(0, 0, math.pi / 2)
			end
			emitterParent = createHostPart(
				targetPart,
				hostName,
				localCFrame * orientation,
				Vector3.new(diameter, 0.05, diameter),
				controller
			)
			shapeKind = "disc"
		elseif spawn.type == 4 and spawn.line then
			local fromCenter = vectorPayloadCenter(spawn.line.from, Vector3.zero)
			local toCenter = vectorPayloadCenter(spawn.line.to, Vector3.zero)
			local along = componentMul(toCenter - fromCenter, parentScale) * unitScale
			local middle = componentMul((fromCenter + toCenter) * 0.5, parentScale) * unitScale
			emitterParent = createHostPart(
				targetPart,
				hostName,
				localCFrame * CFrame.new(middle) * alignYToDirection(along),
				Vector3.new(0.05, math.max(0.05, along.Magnitude), 0.05),
				controller
			)
			shapeKind = "box"
		end
	end
	if not emitterParent then
		if hasSpawnPositionRange(node) and not wantsAttachmentSpawn then
			emitterParent = createHostPart(
				targetPart,
				hostName,
				localCFrame,
				spawnVolumeSize(node, unitScale, parentScale),
				controller
			)
			shapeKind = "box"
		else
			emitterParent = createAttachment(
				targetPart,
				"Effekseer_" .. tostring(node.id) .. "_" .. tostring(node.name),
				localCFrame,
				controller
			)
		end
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Emitter_" .. tostring(node.name)
	emitter.Enabled = false
	emitter.Texture = texture
	emitter.Lifetime = numberRange(lifeMin, lifeMax)
	emitter.Rate = 0
	emitter.Speed = numberRange(
		(node.transform.speed.min or 0) * unitScale * frameRate * speedScale * inheritedSpeedScale,
		(node.transform.speed.max or 0) * unitScale * frameRate * speedScale * inheritedSpeedScale
	)
	-- ParticleEmitter.Acceleration is applied in world space, so rotate the
	-- effect-local vector by the target's orientation at creation time.
	local localAcceleration = componentMul(vectorPayload(node.transform.acceleration.center, Vector3.zero), parentScale)
		* unitScale
		* frameRate
		* frameRate
	emitter.Acceleration = (targetPart.CFrame * rootCFrame).Rotation * localAcceleration
	emitter.EmissionDirection = emissionDirection
	emitter.SpreadAngle = Vector2.new(node.transform.spreadAngle or 0, node.transform.spreadAngle or 0)
	emitter.Color = colorSequence(node)
	emitter.Transparency = transparencySequence(node, lifeMax, frameRate)
	emitter.Size = sizeSequence(node, unitScale, particleSizeScale, parentScale)
	emitter.LightEmission = blendLightEmission(node)
	emitter.LightInfluence = 0
	emitter.LockedToPart = false
	safeSet(emitter, "Orientation", particleOrientationForNode(node))
	if particle2DRotationEnabled(node) then
		emitter.Rotation = numberRange(
			rangeValue(node.transform.rotation.rotation, "min", 0),
			rangeValue(node.transform.rotation.rotation, "max", 0)
		)
		emitter.RotSpeed = numberRange(
			rangeValue(node.transform.rotation.speed, "min", 0) * frameRate,
			rangeValue(node.transform.rotation.speed, "max", 0) * frameRate
		)
	else
		emitter.Rotation = NumberRange.new(0)
		emitter.RotSpeed = NumberRange.new(0)
	end
	if shapeKind == "sphere" then
		pcall(function()
			emitter.Shape = Enum.ParticleEmitterShape.Sphere
		end)
		pcall(function()
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		end)
	elseif shapeKind == "disc" then
		pcall(function()
			emitter.Shape = Enum.ParticleEmitterShape.Disc
		end)
		pcall(function()
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		end)
	elseif shapeKind == "box" then
		pcall(function()
			emitter.Shape = Enum.ParticleEmitterShape.Box
		end)
		pcall(function()
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		end)
	end
	tryApplyFlipbook(emitter, node, frameRate)
	emitter.Parent = emitterParent
	table.insert(controller._emitters, emitter)

	return emitter
end

-- Effekseer ribbons/tracks connect the particles a node emits over time. A
-- moving tracer part with a Trail reproduces that path far more faithfully than
-- a static Beam, so this is used whenever the node actually moves its particles.
local function scheduleTrails(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
): boolean
	if not node.rendered or (node.rendererType ~= "Ribbon" and node.rendererType ~= "Track") then
		return false
	end

	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite, lifeMax =
		visualTiming(node, effect, options, inheritedDelaySeconds)

	local speedStuds = (node.transform.speed.max or 0) * unitScale * frameRate
	if speedStuds < 0.05 and not node.transform.positionKeys then
		-- The trail would collapse to a point; the static Beam is a better fit.
		return false
	end

	local visualScale = unitScale * particleSizeScale * averageXYVector(parentScale)
	local beamVisual = if node.visual then node.visual.beam else nil
	local width =
		math.max(0.02, (if beamVisual then beamVisual.width else node.transform.size.start or 1) * visualScale)
	local texture = textureForNode(node, options, nil)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local windowSeconds = if nodeInfinite then nil else math.max(0.03, math.max(1, maxGeneration) * generationSeconds)

	local marker = Instance.new("Folder")
	marker.Name = "EffekseerTrail_" .. tostring(node.id) .. "_" .. tostring(node.name)
	marker.Parent = targetPart
	table.insert(controller._instances, marker)

	local function spawnTracer(): boolean
		if not controller._alive or not marker.Parent or not targetPart.Parent then
			return false
		end

		local spawnRootCFrame = targetPart.CFrame * rootCFrame
		local positionKeys = node.transform.positionKeys
		local baseOffset = if positionKeys
			then Vector3.zero
			else randomVectorPayload(node.transform.positionRange, Vector3.zero)
		local initialPosition = componentMul(baseOffset + spawnOffsetForIndex(node, 1), parentScale)
		local velocity = componentMul(randomVectorPayload(node.transform.velocity, Vector3.zero), parentScale)
		local acceleration = componentMul(randomVectorPayload(node.transform.acceleration, Vector3.zero), parentScale)

		local tracer = Instance.new("Part")
		tracer.Name = "EffekseerTracer_" .. tostring(node.name)
		tracer.Anchored = true
		tracer.CanCollide = false
		tracer.CanQuery = false
		tracer.CanTouch = false
		tracer.CastShadow = false
		tracer.Massless = true
		tracer.Transparency = 1
		tracer.Size = Vector3.new(0.05, 0.05, 0.05)
		tracer.CFrame = spawnRootCFrame * CFrame.new(initialPosition * unitScale)
		tracer.Parent = targetPart
		table.insert(controller._instances, tracer)

		local attachment0 = Instance.new("Attachment")
		attachment0.Position = Vector3.new(0, width * 0.5, 0)
		attachment0.Parent = tracer
		local attachment1 = Instance.new("Attachment")
		attachment1.Position = Vector3.new(0, -width * 0.5, 0)
		attachment1.Parent = tracer

		local trail = Instance.new("Trail")
		trail.Name = "Trail_" .. tostring(node.name)
		trail.Attachment0 = attachment0
		trail.Attachment1 = attachment1
		trail.Lifetime = lifeMax
		trail.Color = colorSequence(node)
		trail.Transparency = transparencySequence(node, lifeMax, frameRate)
		trail.LightEmission = blendLightEmission(node)
		trail.LightInfluence = 0
		trail.FaceCamera = true
		trail.MinLength = 0
		if texture ~= "" then
			trail.Texture = texture
			safeSet(trail, "TextureMode", Enum.TextureMode.Stretch)
			trail.TextureLength = 1
		end
		trail.Parent = tracer

		task.spawn(function()
			local startClock = os.clock()
			while controller._alive and tracer.Parent do
				local ageSeconds = os.clock() - startClock
				if ageSeconds >= lifeMax then
					break
				end
				local ageFrames = ageSeconds * frameRate
				local localPosition
				if positionKeys then
					localPosition = initialPosition
						+ evaluateKeysVector(positionKeys, ageFrames)
						+ acceleration * (0.5 * ageFrames * ageFrames)
				else
					localPosition = initialPosition
						+ velocity * ageFrames
						+ acceleration * (0.5 * ageFrames * ageFrames)
				end
				tracer.CFrame = spawnRootCFrame * CFrame.new(localPosition * unitScale)
				RunService.Heartbeat:Wait()
			end
			if trail.Parent then
				trail.Enabled = false
			end
			task.delay(lifeMax, function()
				if tracer.Parent then
					tracer:Destroy()
				end
			end)
		end)
		return true
	end

	repeatEveryCycle(
		controller,
		marker,
		offsetSeconds,
		cycleSeconds,
		function(cycleOffset: number, activeCycleSeconds: number?)
			task.spawn(function()
				local startClock = os.clock()
				local windowLimit = windowSeconds
				if nodeInfinite then
					windowLimit = if activeCycleSeconds
						then math.max(0.03, activeCycleSeconds - (cycleOffset or 0))
						else nil
				end
				-- Overlapping tracers every particle lifetime keep a continuous
				-- ribbon while the node is generating.
				repeat
					if not spawnTracer() then
						break
					end
					task.wait(lifeMax)
				until not controller._alive
					or not marker.Parent
					or (windowLimit ~= nil and os.clock() - startClock >= windowLimit)
			end)
		end
	)
	return true
end

local function createBeam(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	parentScale: Vector3,
	controller
): Beam?
	if not node.rendered or (node.rendererType ~= "Ribbon" and node.rendererType ~= "Track") then
		return nil
	end

	local frameRate = effect.frameRate or 60
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local inheritedVisualScale = averageXYVector(parentScale)
	local visualScale = unitScale * particleSizeScale * inheritedVisualScale
	local lifeMax = math.max(1 / frameRate, rangeValue(node.life, "max", 100) / frameRate)
	local beamVisual = if node.visual then node.visual.beam else nil
	local baseSize = math.max(0.05, (node.transform.size.start or 1) * visualScale)
	local width = math.max(0.02, (if beamVisual then beamVisual.width * visualScale else baseSize))
	local length = math.max(width * 2, (if beamVisual then beamVisual.length * visualScale else baseSize * 8))
	local center = nodeCFrame(node, rootCFrame, unitScale, parentScale)
	local half = length * 0.5

	local attachment0 = createAttachment(
		targetPart,
		"EffekseerBeam0_" .. tostring(node.id) .. "_" .. tostring(node.name),
		center * CFrame.new(-half, 0, 0),
		controller
	)
	local attachment1 = createAttachment(
		targetPart,
		"EffekseerBeam1_" .. tostring(node.id) .. "_" .. tostring(node.name),
		center * CFrame.new(half, 0, 0),
		controller
	)

	local beam = Instance.new("Beam")
	beam.Name = "Beam_" .. tostring(node.name)
	beam.Attachment0 = attachment0
	beam.Attachment1 = attachment1
	beam.Enabled = false
	beam.Width0 = width
	beam.Width1 = width
	beam.FaceCamera = true
	beam.Segments = 8
	beam.Color = colorSequence(node)
	beam.Transparency = transparencySequence(node, lifeMax, frameRate)
	beam.LightEmission = blendLightEmission(node)
	beam.LightInfluence = 0
	local texture = textureForNode(node, options, nil)
	if texture ~= "" then
		beam.Texture = texture
		beam.TextureLength = math.max(0.1, length)
		pcall(function()
			beam.TextureMode = Enum.TextureMode.Wrap
		end)
		local uv = node.uv
		if uv and uv.type == 3 and uv.scroll then
			-- Approximate Effekseer's UV scroll (px/frame) as texture cycles per second.
			local speed = uv.scroll.speed
			local sizeReference = math.max(1, math.abs(uv.size.x or 0), math.abs(uv.size.y or 0))
			local dominant = if math.abs(speed.y or 0) >= math.abs(speed.x or 0) then speed.y or 0 else speed.x or 0
			safeSet(beam, "TextureSpeed", (dominant / sizeReference) * frameRate)
		end
	end
	beam.Parent = targetPart
	table.insert(controller._instances, beam)
	table.insert(controller._beams, beam)

	return beam
end

local function createModelVisual(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	parentScale: Vector3,
	controller
): BasePart?
	if not node.rendered or node.rendererType ~= "Model" then
		return nil
	end

	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local size = math.max(
		0.05,
		averageXYVector(componentMul(sizeVectorAt(node, 0), parentScale)) * unitScale * particleSizeScale
	)
	local modelAsset = modelAssetForNode(node, options)
	local part: BasePart

	if modelAsset and modelAsset ~= "" then
		local ok, meshPart = pcall(function()
			local mesh = Instance.new("MeshPart")
			mesh.MeshId = modelAsset
			local texture = textureForNode(node, options, nil)
			if texture ~= "" then
				mesh.TextureID = texture
			end
			return mesh
		end)
		part = if ok then meshPart :: BasePart else Instance.new("Part")
	else
		part = Instance.new("Part")
		safeSet(part, "Shape", Enum.PartType.Ball)
	end

	part.Name = "Model_" .. tostring(node.name)
	-- Anchored so scheduleModelPart can drive the CFrame each frame (PVA motion,
	-- rotation, and scale animation) while still following the target part.
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.Material = if node.alphaBlend == 2 then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.Color = color3(node.color)
	part.Size = Vector3.new(size, size, size)
	part.Transparency = 1
	part.CFrame = targetPart.CFrame * nodeCFrame(node, rootCFrame, unitScale, parentScale)
	part.Parent = targetPart

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)

	return part
end

local function scheduleModelPart(
	node: EffectNode,
	part: BasePart,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
)
	local frameRate, _, _, offsetSeconds, nodeInfinite, lifeMax, duration =
		visualTiming(node, effect, options, inheritedDelaySeconds)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1

	local function animate(activeSeconds: number?)
		task.spawn(function()
			local spawnRootCFrame = targetPart.CFrame * rootCFrame
			local positionKeys = node.transform.positionKeys
			local rotationKeys = node.transform.rotation.rotationKeys
			local baseOffset = if positionKeys
				then Vector3.zero
				else randomVectorPayload(node.transform.positionRange, Vector3.zero)
			local initialPosition = componentMul(baseOffset + spawnOffsetForIndex(node, 1), parentScale)
			local velocity = componentMul(randomVectorPayload(node.transform.velocity, Vector3.zero), parentScale)
			local acceleration =
				componentMul(randomVectorPayload(node.transform.acceleration, Vector3.zero), parentScale)
			local initialRotation = randomVectorPayload(node.transform.rotation.rotation3, Vector3.zero)
			local rotationSpeed = randomVectorPayload(node.transform.rotation.speed3, Vector3.zero)
			local scaleState = sampleScaleState(node)
			local startClock = os.clock()
			local limit = math.min(lifeMax, activeSeconds or lifeMax)

			while controller._alive and part.Parent do
				local ageSeconds = os.clock() - startClock
				if ageSeconds >= limit then
					break
				end
				local ageFrames = ageSeconds * frameRate
				local t = math.clamp(ageSeconds / math.max(lifeMax, 1 / frameRate), 0, 1)
				local localPosition
				if positionKeys then
					localPosition = initialPosition
						+ evaluateKeysVector(positionKeys, ageFrames)
						+ acceleration * (0.5 * ageFrames * ageFrames)
				else
					localPosition = initialPosition
						+ velocity * ageFrames
						+ acceleration * (0.5 * ageFrames * ageFrames)
				end
				local rotation
				if rotationKeys then
					rotation = evaluateKeysVector(rotationKeys, ageFrames)
				else
					rotation = initialRotation + rotationSpeed * ageFrames
				end
				local scaleVector = componentMul(scaleStateVector(scaleState, t, ageFrames), parentScale)
					* unitScale
					* particleSizeScale
				part.CFrame = spawnRootCFrame
					* CFrame.new(localPosition * unitScale)
					* rotationZXY({ x = rotation.X, y = rotation.Y, z = rotation.Z })
				part.Size = Vector3.new(
					math.max(0.05, math.abs(scaleVector.X)),
					math.max(0.05, math.abs(scaleVector.Y)),
					math.max(0.05, math.abs(scaleVector.Z))
				)
				part.Color = color3At(node, t)
				part.Transparency = spriteTransparencyAt(node, ageSeconds, lifeMax, frameRate)
				RunService.Heartbeat:Wait()
			end

			if part.Parent then
				part.Transparency = 1
			end
		end)
	end

	repeatEveryCycle(
		controller,
		part,
		offsetSeconds,
		cycleSeconds,
		function(cycleOffset: number, activeCycleSeconds: number?)
			if not controller._alive or not part.Parent then
				return
			end
			local activeSeconds: number? = nil
			if nodeInfinite and activeCycleSeconds then
				activeSeconds = math.max(0.03, activeCycleSeconds - cycleOffset)
			elseif not nodeInfinite then
				activeSeconds = duration
			end
			animate(activeSeconds)
		end
	)
end

local function scheduleSound(
	node: EffectNode,
	targetPart: BasePart,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local soundPayload = node.sound
	if not soundPayload then
		return
	end

	local asset: any = nil
	if options.assetMap then
		asset = assetMapValue(options.assetMap, soundPayload.wave, nil)
			or assetMapValue(options.assetMap, "Sound/" .. soundPayload.wave, nil)
	end
	if asset == nil and soundPayload.asset and soundPayload.asset ~= "" then
		asset = soundPayload.asset
	end
	if asset == nil or asset == "" then
		return
	end

	local frameRate = effect.frameRate or 60
	local _, _, _, offsetSeconds = visualTiming(node, effect, options, inheritedDelaySeconds)
	local delaySeconds = offsetSeconds + math.max(0, rangeValue(soundPayload.delay, "center", 0) / frameRate)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil

	local sound = Instance.new("Sound")
	sound.Name = "EffekseerSound_" .. tostring(node.id) .. "_" .. tostring(node.name)
	if typeof(asset) == "Content" then
		local ok = pcall(function()
			(sound :: any).SoundId = asset
		end)
		if not ok then
			return
		end
	else
		sound.SoundId = asset
	end
	sound.Parent = targetPart
	table.insert(controller._instances, sound)

	repeatEveryCycle(controller, sound, delaySeconds, cycleSeconds, function()
		if not controller._alive or not sound.Parent then
			return
		end
		sound.Volume = randomRangePayload(soundPayload.volume, 1)
		-- Effekseer pitch is in octaves around 0.
		sound.PlaybackSpeed = 2 ^ randomRangePayload(soundPayload.pitch, 0)
		sound:Play()
	end)
end

local function scheduleEmitter(
	node: EffectNode,
	emitter: ParticleEmitter,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
)
	local frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite =
		visualTiming(node, effect, options, inheritedDelaySeconds)
	local burstTaskLimit = options.burstTaskLimit or 200
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local rate = 1 / generationSeconds
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local attachment = emitter.Parent
	local baseCFrame = if attachment and attachment:IsA("Attachment") then attachment.CFrame else CFrame.identity

	if nodeInfinite then
		repeatEveryCycle(
			controller,
			emitter,
			offsetSeconds,
			cycleSeconds,
			function(cycleOffset: number, activeCycleSeconds: number?)
				scheduleRateWindow(emitter, rate, nil, controller, cycleOffset, activeCycleSeconds)
			end
		)
		return
	end

	maxGeneration = math.max(0, maxGeneration)
	if maxGeneration <= burstTaskLimit then
		repeatEveryCycle(controller, emitter, offsetSeconds, cycleSeconds, function()
			emitBurstForNode(
				node,
				emitter,
				maxGeneration,
				generationSeconds,
				controller,
				baseCFrame,
				unitScale,
				parentScale
			)
		end)
	else
		local duration = maxGeneration / rate
		repeatEveryCycle(controller, emitter, offsetSeconds, cycleSeconds, function()
			scheduleRateWindow(emitter, rate, duration, controller, nil, nil)
		end)
	end
end

visitNodes = function(
	nodes: { EffectNode },
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	parentScale: Vector3,
	inheritedDelaySeconds: number?
)
	local unitScale = options.unitScale or effect.unitScale or 0.01
	for _, node in nodes do
		scheduleSound(node, targetPart, effect, options, controller, inheritedDelaySeconds)
		local spritePartsHandled = scheduleSpriteParts(
			node,
			targetPart,
			rootCFrame,
			effect,
			options,
			controller,
			parentScale,
			inheritedDelaySeconds
		)
		local emitter = createParticleEmitter(node, targetPart, rootCFrame, effect, options, parentScale, controller)
		if emitter then
			scheduleEmitter(node, emitter, effect, options, controller, parentScale, inheritedDelaySeconds)
		end
		if not spritePartsHandled then
			local trailHandled = scheduleTrails(
				node,
				targetPart,
				rootCFrame,
				effect,
				options,
				controller,
				parentScale,
				inheritedDelaySeconds
			)
			if not trailHandled then
				local beam = createBeam(node, targetPart, rootCFrame, effect, options, parentScale, controller)
				if beam then
					scheduleBeam(node, beam, effect, options, controller, inheritedDelaySeconds)
				end
			end
			local model = createModelVisual(node, targetPart, rootCFrame, effect, options, parentScale, controller)
			if model then
				scheduleModelPart(
					node,
					model,
					targetPart,
					rootCFrame,
					effect,
					options,
					controller,
					parentScale,
					inheritedDelaySeconds
				)
			end
		end
		if not spritePartsHandled then
			local childScale = componentMul(parentScale, inheritedScaleForNode(node))
			visitNodes(
				node.children or {},
				targetPart,
				nodeCFrame(node, rootCFrame, unitScale, parentScale),
				effect,
				options,
				controller,
				childScale,
				(inheritedDelaySeconds or 0) + nodeLocalDelay(node, effect)
			)
		end
	end
end

function EffekseerPlayer.play(effect: EffectData, target: Instance, options: PlayOptions?)
	local playOptions: PlayOptions = options or {}

	local targetPart, rootCFrame = resolveTarget(target)
	if playOptions.hideTarget == true then
		targetPart.Transparency = 1
	end

	local controller = setmetatable({
		_alive = true,
		_instances = {},
		_emitters = {},
		_beams = {},
		_parts = {},
	}, Controller)

	visitNodes(effect.nodes, targetPart, rootCFrame, effect, playOptions, controller, Vector3.new(1, 1, 1), 0)

	-- autoDestroy would cut a looping effect off after its first cycle, so it only
	-- applies when the effect is not looping.
	if playOptions.autoDestroy and not effectLoopEnabled(effect, playOptions) then
		local longest = 0
		local frameRate = effect.frameRate or 60
		local function scan(nodes: { EffectNode }, inheritedOffset: number)
			for _, node in nodes do
				local offset = inheritedOffset + rangeValue(node.generation.offset, "max", 0) / frameRate
				local generation = if node.generation.max == 0
					then 0
					else (node.generation.max or 1) * rangeValue(node.generation.time, "max", 1) / frameRate
				local life = nodeLifeFrames(node, effect, "max") / frameRate
				longest = math.max(longest, offset + generation + life)
				scan(node.children or {}, offset)
			end
		end
		scan(effect.nodes, 0)
		task.delay(longest, function()
			if controller._alive then
				controller:Destroy()
			end
		end)
	end

	return controller
end

return EffekseerPlayer
