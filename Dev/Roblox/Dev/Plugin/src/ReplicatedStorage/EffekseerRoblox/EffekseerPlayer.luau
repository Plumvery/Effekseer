}

type BakedKeys = {
	frames: { number },
	values: { VectorPayload },
}

type UVPayload = {
	type: number,
	start: { x: number, y: number },
	size: { x: number, y: number },
	animation: {
		frameLength: number,
		countX: number,
		countY: number,
		loopType: number,
		startSheet: number,
	}?,
	scroll: {
		speed: { x: number, y: number },
	}?,
}

