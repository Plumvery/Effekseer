-- Roblox runtime for Luau modules generated by Dev/Roblox/bin/effekseer-for-roblox.js.

local EffekseerPlayer = {}
local TweenService = game:GetService("TweenService")

type VectorPayload = {
	x: number,
	y: number,
	z: number,
}

type RangePayload = {
	min: number,
	max: number,
	center: number?,
}

type EffectNode = {
	id: string,
	name: string,
	rendererType: string,
	rendered: boolean,
	texturePath: string?,
	texture: string?,
	alphaBlend: number,
	fadeIn: number,
	fadeOut: number,
	color: { r: number, g: number, b: number, a: number },
	colorOverLife: {
		start: { r: number, g: number, b: number, a: number },
		finish: { r: number, g: number, b: number, a: number },
	}?,
	visual: {
		sprite: {
			billboard: number?,
		}?,
		beam: {
			width: number,
			length: number,
		}?,
		ring: {
			vertexCount: number,
			outerRadius: number,
			innerRadius: number,
		}?,
		model: {
			path: string?,
			asset: string?,
		}?,
	}?,
	life: RangePayload,
	generation: {
		max: number,
		time: RangePayload,
		offset: RangePayload,
	},
	transform: {
		position: VectorPayload,
		positionRange: {
			center: VectorPayload,
			min: VectorPayload,
			max: VectorPayload,
		}?,
		acceleration: { center: VectorPayload },
		speed: { min: number, max: number },
		emissionDirection: string,
		spreadAngle: number,
		rotation: {
			rotation: RangePayload,
			speed: RangePayload,
			rotation3: {
				center: VectorPayload,
				min: VectorPayload,
				max: VectorPayload,
			}?,
			speed3: {
				center: VectorPayload,
				min: VectorPayload,
				max: VectorPayload,
			}?,
		},
		size: {
			start: number,
			finish: number,
			envelope: number,
		},
	},
	children: { EffectNode },
}

type EffectData = {
	name: string,
	frameRate: number?,
	startFrame: number?,
	endFrame: number?,
	durationFrames: number?,
	isLoop: boolean?,
	unitScale: number?,
	particleSizeScale: number?,
	nodes: { EffectNode },
}

type PlayOptions = {
	loop: boolean?,
	unitScale: number?,
	particleSizeScale: number?,
	speedScale: number?,
	assetMap: { [string]: string }?,
	autoDestroy: boolean?,
	burstTaskLimit: number?,
	hideTarget: boolean?,
	name: string?,
}

local NORMAL_IDS: { [string]: Enum.NormalId } = {
	Top = Enum.NormalId.Top,
	Bottom = Enum.NormalId.Bottom,
	Left = Enum.NormalId.Left,
	Right = Enum.NormalId.Right,
	Front = Enum.NormalId.Front,
	Back = Enum.NormalId.Back,
}

local RING_FALLBACK_TEXTURE = "rbxasset://textures/particles/smoke_main.dds"

local function safeSet(instance: Instance, property: string, value)
	pcall(function()
		(instance :: any)[property] = value
	end)
end

local function assetMapValue(assetMap: { [string]: string }, assetPath: string): string?
	local direct = assetMap[assetPath]
	if direct and direct ~= "" then
		return direct
	end

	local basename = string.match(assetPath, "[^/\\]+$")
	if basename then
		local named = assetMap[basename]
		if named and named ~= "" then
			return named
		end

		local textureNamed = assetMap["Texture/" .. basename]
		if textureNamed and textureNamed ~= "" then
			return textureNamed
		end

		local modelNamed = assetMap["Model/" .. basename]
		if modelNamed and modelNamed ~= "" then
			return modelNamed
		end
	end

	local lowered = string.lower(assetPath)
	local lowerDirect = assetMap[lowered]
	if lowerDirect and lowerDirect ~= "" then
		return lowerDirect
	end

	if basename then
		local lowerBasename = string.lower(basename)
		local lowerNamed = assetMap[lowerBasename]
		if lowerNamed and lowerNamed ~= "" then
			return lowerNamed
		end

		local lowerTextureNamed = assetMap["texture/" .. lowerBasename]
		if lowerTextureNamed and lowerTextureNamed ~= "" then
			return lowerTextureNamed
		end

		local lowerModelNamed = assetMap["model/" .. lowerBasename]
		if lowerModelNamed and lowerModelNamed ~= "" then
			return lowerModelNamed
		end
	end

	return nil
end

local function rangeValue(range: RangePayload?, key: string, fallback: number): number
	if range == nil then
		return fallback
	end

	local value = (range :: any)[key]
	if typeof(value) == "number" then
		return value
	end

	if typeof(range.center) == "number" then
		return range.center
	end

	return fallback
end

local function toVector3(value: VectorPayload?, scale: number): Vector3
	if value == nil then
		return Vector3.zero
	end

	return Vector3.new(value.x or 0, value.y or 0, value.z or 0) * scale
end

local function randomBetween(minValue: number, maxValue: number): number
	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end
	return minValue + (maxValue - minValue) * math.random()
end

local function numberRange(minValue: number, maxValue: number): NumberRange
	if minValue > maxValue then
		minValue, maxValue = maxValue, minValue
	end

	return NumberRange.new(minValue, maxValue)
end

local function color3(color: { r: number, g: number, b: number }): Color3
	return Color3.fromRGB(color.r or 255, color.g or 255, color.b or 255)
end

local function colorSequence(node: EffectNode): ColorSequence
	if node.colorOverLife then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, color3(node.colorOverLife.start)),
			ColorSequenceKeypoint.new(1, color3(node.colorOverLife.finish)),
		})
	end

	return ColorSequence.new(color3(node.color))
end

local function visibleTransparency(node: EffectNode): number
	return 1 - math.clamp((node.color.a or 255) / 255, 0, 1)
end

local function transparencySequence(node: EffectNode, lifeSeconds: number, frameRate: number): NumberSequence
	local startColor = if node.colorOverLife then node.colorOverLife.start else node.color
	local finishColor = if node.colorOverLife then node.colorOverLife.finish else node.color
	local startTransparency = 1 - math.clamp((startColor.a or 255) / 255, 0, 1)
	local finishTransparency = 1 - math.clamp((finishColor.a or 255) / 255, 0, 1)
	local fadeIn = math.max(0, node.fadeIn or 0)
	local fadeOut = math.max(0, node.fadeOut or 0)
	local duration = math.max(1 / frameRate, lifeSeconds)

	if fadeIn <= 0 and fadeOut <= 0 and startTransparency == finishTransparency then
		return NumberSequence.new(startTransparency)
	end

	local fadeInT = math.clamp((fadeIn / frameRate) / duration, 0, 0.98)
	local fadeOutT = math.clamp(1 - (fadeOut / frameRate) / duration, fadeInT, 1)

	local keypoints = {
		NumberSequenceKeypoint.new(0, if fadeIn > 0 then 1 else startTransparency),
	}

	if fadeIn > 0 then
		table.insert(keypoints, NumberSequenceKeypoint.new(fadeInT, startTransparency))
	end

	if fadeOut > 0 then
		table.insert(keypoints, NumberSequenceKeypoint.new(fadeOutT, finishTransparency))
		table.insert(keypoints, NumberSequenceKeypoint.new(1, 1))
	elseif startTransparency ~= finishTransparency then
		table.insert(keypoints, NumberSequenceKeypoint.new(1, finishTransparency))
	else
		table.insert(keypoints, NumberSequenceKeypoint.new(1, startTransparency))
	end

	return NumberSequence.new(keypoints)
end

local function blendLightEmission(node: EffectNode): number
	return if node.alphaBlend == 2 then 1 else 0
end

local function sizeSequence(node: EffectNode, unitScale: number, particleSizeScale: number): NumberSequence
	local size = node.transform.size
	local scale = unitScale * particleSizeScale
	local startSize = math.max(0.01, (size.start or 1) * scale)
	local finishSize = math.max(0.01, (size.finish or size.start or 1) * scale)
	local envelope = math.max(0, (size.envelope or 0) * scale)

	if math.abs(startSize - finishSize) < 1e-5 then
		if envelope <= 0 then
			return NumberSequence.new(startSize)
		end

		return NumberSequence.new({
			NumberSequenceKeypoint.new(0, startSize, envelope),
			NumberSequenceKeypoint.new(1, startSize, envelope),
		})
	end

	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, startSize, envelope),
		NumberSequenceKeypoint.new(1, finishSize, envelope),
	})
end

local function resolveTarget(target: Instance): (BasePart, CFrame)
	if target:IsA("Attachment") then
		local parent = target.Parent
		assert(parent and parent:IsA("BasePart"), "Effekseer target Attachment must be parented to a BasePart")
		return parent, target.CFrame
	end

	if target:IsA("BasePart") then
		return target, CFrame.identity
	end

	if target:IsA("Model") then
		local primaryPart = target.PrimaryPart
		assert(primaryPart ~= nil, "Effekseer target Model must have PrimaryPart set")
		return primaryPart, CFrame.identity
	end

	error("Effekseer target must be a BasePart, Attachment, or Model")
end

local Controller = {}
Controller.__index = Controller

function Controller:Stop()
	self._alive = false
	for _, emitter in self._emitters do
		if emitter.Parent then
			emitter.Enabled = false
		end
	end
	for _, beam in self._beams do
		if beam.Parent then
			beam.Enabled = false
		end
	end
	for _, part in self._parts do
		if part.Parent then
			part.Transparency = 1
			for _, child in part:GetChildren() do
				if child:IsA("Decal") then
					child.Transparency = 1
				end
			end
		end
	end
end

function Controller:Destroy()
	self:Stop()
	for _, instance in self._instances do
		if instance.Parent then
			instance:Destroy()
		end
	end
	table.clear(self._instances)
	table.clear(self._emitters)
	table.clear(self._beams)
	table.clear(self._parts)
end

local function textureForNode(node: EffectNode, options: PlayOptions, fallback: string?): string
	if options.assetMap and node.texturePath then
		local mappedTexture = assetMapValue(options.assetMap, node.texturePath)
		if mappedTexture then
			return mappedTexture
		end
	end

	local texture = node.texture
	return texture or fallback or ""
end

local function modelAssetForNode(node: EffectNode, options: PlayOptions): string?
	local model = if node.visual then node.visual.model else nil
	if not model then
		return nil
	end

	if options.assetMap and model.path and model.path ~= "" then
		local mappedModel = assetMapValue(options.assetMap, model.path)
		if mappedModel then
			return mappedModel
		end
	end

	if model.asset and model.asset ~= "" then
		return model.asset
	end

	return nil
end

local function enumValue(enumType, name: string)
	local ok, value = pcall(function()
		return (enumType :: any)[name]
	end)
	if ok then
		return value
	end
	return nil
end

local function spriteBillboardMode(node: EffectNode): number
	local sprite = if node.visual then node.visual.sprite else nil
	local billboard = if sprite then sprite.billboard else nil
	return billboard or 0
end

local function particleOrientationForNode(node: EffectNode)
	local billboard = spriteBillboardMode(node)
	if billboard == 1 then
		return enumValue(Enum.ParticleOrientation, "FacingCameraWorldUp") or Enum.ParticleOrientation.FacingCamera
	end
	if billboard == 2 then
		return enumValue(Enum.ParticleOrientation, "FacingCameraWorldUp") or Enum.ParticleOrientation.FacingCamera
	end
	if billboard == 4 then
		return enumValue(Enum.ParticleOrientation, "VelocityParallel") or Enum.ParticleOrientation.FacingCamera
	end
	return Enum.ParticleOrientation.FacingCamera
end

local function nodeCFrame(node: EffectNode, rootCFrame: CFrame, unitScale: number): CFrame
	local rotation3 = node.transform.rotation.rotation3
	local rotation = if rotation3 then rotation3.center else nil
	local x = if rotation then rotation.x or 0 else 0
	local y = if rotation then rotation.y or 0 else 0
	local z = if rotation then rotation.z or 0 else rangeValue(node.transform.rotation.rotation, "center", 0)
	return rootCFrame
		* CFrame.new(toVector3(node.transform.position, unitScale))
		* CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
end

local function createAttachment(targetPart: BasePart, name: string, cframe: CFrame, controller): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.CFrame = cframe
	attachment.Parent = targetPart
	table.insert(controller._instances, attachment)
	return attachment
end

local function createHostPart(targetPart: BasePart, name: string, cframe: CFrame, size: Vector3, controller): BasePart
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Transparency = 1
	part.Size = size
	part.CFrame = targetPart.CFrame * cframe
	part.Parent = targetPart

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = targetPart
	weld.Part1 = part
	weld.Parent = part

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)
	return part
end

local function visualTiming(node: EffectNode, effect: EffectData, options: PlayOptions, inheritedDelaySeconds: number?)
	local frameRate = effect.frameRate or 60
	local maxGeneration = node.generation.max or 1
	local generationFrames = math.max(0.001, rangeValue(node.generation.time, "center", 1))
	local generationSeconds = generationFrames / frameRate
	local offsetSeconds = (inheritedDelaySeconds or 0)
		+ math.max(0, rangeValue(node.generation.offset, "center", 0) / frameRate)
	local nodeInfinite = maxGeneration == 0
	local lifeMax = math.max(1 / frameRate, rangeValue(node.life, "max", 100) / frameRate)
	local duration = if nodeInfinite then 0 else math.max(lifeMax, math.max(1, maxGeneration) * generationSeconds + lifeMax)
	return frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite, lifeMax, duration
end

local function nodeLocalDelay(node: EffectNode, effect: EffectData): number
	local frameRate = effect.frameRate or 60
	return math.max(0, rangeValue(node.generation.offset, "center", 0) / frameRate)
end

local function effectLoopEnabled(effect: EffectData, options: PlayOptions): boolean
	return options.loop == true or (options.loop == nil and effect.isLoop == true)
end

local function effectCycleSeconds(effect: EffectData, frameRate: number): number?
	local durationFrames = effect.durationFrames
	if not durationFrames or durationFrames <= 0 then
		durationFrames = math.max(0, (effect.endFrame or 0) - (effect.startFrame or 0))
	end
	if durationFrames and durationFrames > 0 then
		return durationFrames / frameRate
	end
	return nil
end

local function repeatEveryCycle(controller, instance: Instance, offsetSeconds: number, cycleSeconds: number?, callback)
	if cycleSeconds and cycleSeconds > 0 then
		local cycleOffset = offsetSeconds % cycleSeconds
		task.spawn(function()
			task.wait(cycleOffset)
			while controller._alive and instance.Parent do
				callback(cycleOffset, cycleSeconds)
				task.wait(cycleSeconds)
			end
		end)
		return
	end

	task.delay(offsetSeconds, function()
		if controller._alive and instance.Parent then
			callback(offsetSeconds, nil)
		end
	end)
end

local function scheduleBeam(
	node: EffectNode,
	beam: Beam,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local frameRate, _, _, offsetSeconds, nodeInfinite, _, duration = visualTiming(
		node,
		effect,
		options,
		inheritedDelaySeconds
	)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil

	repeatEveryCycle(controller, beam, offsetSeconds, cycleSeconds, function(cycleOffset: number, activeCycleSeconds: number?)
		if not controller._alive or not beam.Parent then
			return
		end
		beam.Enabled = true

		local visibleSeconds = duration
		if nodeInfinite and activeCycleSeconds then
			visibleSeconds = math.max(0.03, activeCycleSeconds - cycleOffset)
		end
		if not nodeInfinite or activeCycleSeconds then
			task.delay(visibleSeconds, function()
				if beam.Parent then
					beam.Enabled = false
				end
			end)
		end
	end)
end

local function setPartVisible(node: EffectNode, part: BasePart, visible: boolean)
	part.Transparency = if visible then visibleTransparency(node) else 1
end

local function scheduleDisablePart(node: EffectNode, part: BasePart, delaySeconds: number)
	task.delay(delaySeconds, function()
		if part.Parent then
			setPartVisible(node, part, false)
		end
	end)
end

local function schedulePart(
	node: EffectNode,
	part: BasePart,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local frameRate, _, _, offsetSeconds, nodeInfinite, _, duration = visualTiming(
		node,
		effect,
		options,
		inheritedDelaySeconds
	)
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil

	repeatEveryCycle(controller, part, offsetSeconds, cycleSeconds, function(cycleOffset: number, activeCycleSeconds: number?)
		if not controller._alive or not part.Parent then
			return
		end
		setPartVisible(node, part, true)

		if nodeInfinite and activeCycleSeconds then
			scheduleDisablePart(node, part, math.max(0.03, activeCycleSeconds - cycleOffset))
		elseif not nodeInfinite then
			scheduleDisablePart(node, part, duration)
		end
	end)
end

local function disableEmitterAfter(emitter: ParticleEmitter, delaySeconds: number)
	task.delay(delaySeconds, function()
		if emitter.Parent then
			emitter.Enabled = false
			emitter.Rate = 0
		end
	end)
end

local function emitBurst(emitter: ParticleEmitter, count: number, generationSeconds: number, controller)
	for index = 1, count do
		task.delay((index - 1) * generationSeconds, function()
			if not controller._alive or not emitter.Parent then
				return
			end
			emitter:Emit(1)
		end)
	end
end

local function hasSpawnPositionRange(node: EffectNode): boolean
	local range = node.transform.positionRange
	if not range then
		return false
	end

	for _, axis in { "x", "y", "z" } do
		local minValue = (range.min :: any)[axis] or 0
		local maxValue = (range.max :: any)[axis] or 0
		local centerValue = (range.center :: any)[axis] or 0
		if math.abs(minValue - centerValue) > 1e-6 or math.abs(maxValue - centerValue) > 1e-6 then
			return true
		end
	end

	return false
end

local function spawnVolumeSize(node: EffectNode, unitScale: number): Vector3
	local range = node.transform.positionRange
	if not range then
		return Vector3.new(0.05, 0.05, 0.05)
	end

	return Vector3.new(
		math.max(0.05, math.abs((range.max.x or 0) - (range.min.x or 0)) * unitScale),
		math.max(0.05, math.abs((range.max.y or 0) - (range.min.y or 0)) * unitScale),
		math.max(0.05, math.abs((range.max.z or 0) - (range.min.z or 0)) * unitScale)
	)
end

local function randomSpawnCFrame(node: EffectNode, baseCFrame: CFrame, unitScale: number): CFrame
	local range = node.transform.positionRange
	if not range then
		return baseCFrame
	end

	local center = range.center
	local offset = Vector3.new(
		randomBetween(range.min.x or 0, range.max.x or 0) - (center.x or 0),
		randomBetween(range.min.y or 0, range.max.y or 0) - (center.y or 0),
		randomBetween(range.min.z or 0, range.max.z or 0) - (center.z or 0)
	)
	return baseCFrame * CFrame.new(offset * unitScale)
end

local function emitBurstForNode(
	node: EffectNode,
	emitter: ParticleEmitter,
	count: number,
	generationSeconds: number,
	controller,
	baseCFrame: CFrame,
	unitScale: number
)
	local attachment = emitter.Parent
	if not attachment or not attachment:IsA("Attachment") or not hasSpawnPositionRange(node) then
		emitBurst(emitter, count, generationSeconds, controller)
		return
	end

	for index = 1, count do
		task.delay((index - 1) * generationSeconds, function()
			if not controller._alive or not emitter.Parent or not attachment.Parent then
				return
			end
			attachment.CFrame = randomSpawnCFrame(node, baseCFrame, unitScale)
			emitter:Emit(1)
			attachment.CFrame = baseCFrame
		end)
	end
end

local function scheduleRateWindow(
	emitter: ParticleEmitter,
	rate: number,
	durationSeconds: number?,
	controller,
	cycleOffset: number?,
	cycleSeconds: number?
)
	if not controller._alive or not emitter.Parent then
		return
	end
	emitter.Rate = rate
	emitter.Enabled = true

	if durationSeconds then
		disableEmitterAfter(emitter, durationSeconds)
	elseif cycleSeconds then
		disableEmitterAfter(emitter, math.max(0.03, cycleSeconds - (cycleOffset or 0)))
	end
end

local function isFixedSprite(node: EffectNode): boolean
	return node.rendererType == "Sprite" and spriteBillboardMode(node) == 2
end

local function setDecalVisible(node: EffectNode, decal: Decal, visible: boolean)
	decal.Transparency = if visible then visibleTransparency(node) else 1
end

local function createSpritePlane(
	node: EffectNode,
	targetPart: BasePart,
	localCFrame: CFrame,
	texture: string,
	unitScale: number,
	particleSizeScale: number,
	controller
): BasePart
	local startSize = math.max(0.01, (node.transform.size.start or 1) * unitScale * particleSizeScale)
	local part = Instance.new("Part")
	part.Name = "Sprite_" .. tostring(node.name)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Transparency = 1
	part.Size = Vector3.new(startSize, startSize, 0.01)
	part.CFrame = targetPart.CFrame * localCFrame
	part.Parent = targetPart

	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local decal = Instance.new("Decal")
		decal.Name = "EffekseerSprite"
		decal.Face = face
		decal.Texture = texture
		decal.Color3 = color3(node.color)
		setDecalVisible(node, decal, false)
		decal.Parent = part
	end

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = targetPart
	weld.Part1 = part
	weld.Parent = part

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)
	return part
end

local function showSpritePlane(node: EffectNode, part: BasePart, lifeSeconds: number, unitScale: number, particleSizeScale: number)
	local finishSize = math.max(
		0.01,
		((node.transform.size.finish or node.transform.size.start or 1) * unitScale * particleSizeScale)
	)
	for _, child in part:GetChildren() do
		if child:IsA("Decal") then
			setDecalVisible(node, child, true)
			if node.fadeOut > 0 then
				TweenService:Create(child, TweenInfo.new(lifeSeconds), { Transparency = 1 }):Play()
			end
		end
	end
	if math.abs(part.Size.X - finishSize) > 1e-5 then
		TweenService:Create(part, TweenInfo.new(lifeSeconds), { Size = Vector3.new(finishSize, finishSize, 0.01) }):Play()
	end
	task.delay(lifeSeconds, function()
		if part.Parent then
			part:Destroy()
		end
	end)
end

local function scheduleFixedSprite(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
): boolean
	if not node.rendered or not isFixedSprite(node) then
		return false
	end

	local texture = textureForNode(node, options, nil)
	if texture == "" then
		return true
	end

	local frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite, lifeMax = visualTiming(
		node,
		effect,
		options,
		inheritedDelaySeconds
	)
	if nodeInfinite then
		return false
	end

	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local marker = Instance.new("Folder")
	marker.Name = "EffekseerFixedSprite_" .. tostring(node.id) .. "_" .. tostring(node.name)
	marker.Parent = targetPart
	table.insert(controller._instances, marker)

	repeatEveryCycle(controller, marker, offsetSeconds, cycleSeconds, function()
		for index = 1, math.max(0, maxGeneration) do
			task.delay((index - 1) * generationSeconds, function()
				if not controller._alive or not marker.Parent then
					return
				end
				local localCFrame = randomSpawnCFrame(node, nodeCFrame(node, rootCFrame, unitScale), unitScale)
				local part = createSpritePlane(node, targetPart, localCFrame, texture, unitScale, particleSizeScale, controller)
				showSpritePlane(node, part, lifeMax, unitScale, particleSizeScale)
			end)
		end
	end)

	return true
end

local function createParticleEmitter(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller
): ParticleEmitter?
	if not node.rendered then
		return nil
	end
	if isFixedSprite(node) then
		return nil
	end
	if node.rendererType == "Ribbon" or node.rendererType == "Track" or node.rendererType == "Model" then
		return nil
	end

	local hasTexturePath = node.texturePath ~= nil and node.texturePath ~= ""
	local fallbackTexture = if node.rendererType == "Ring" and not hasTexturePath then RING_FALLBACK_TEXTURE else nil
	local texture = textureForNode(node, options, fallbackTexture)
	if hasTexturePath and texture == "" then
		return nil
	end

	local frameRate = effect.frameRate or 60
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local speedScale = options.speedScale or 1
	local lifeMin = math.max(1 / frameRate, rangeValue(node.life, "min", 100) / frameRate)
	local lifeMax = math.max(lifeMin, rangeValue(node.life, "max", 100) / frameRate)

	local localCFrame = nodeCFrame(node, rootCFrame, unitScale)
	local emitterParent: Instance
	if hasSpawnPositionRange(node) then
		emitterParent = createHostPart(
			targetPart,
			"EffekseerVolume_" .. tostring(node.id) .. "_" .. tostring(node.name),
			localCFrame,
			spawnVolumeSize(node, unitScale),
			controller
		)
	else
		emitterParent = createAttachment(
			targetPart,
			"Effekseer_" .. tostring(node.id) .. "_" .. tostring(node.name),
			localCFrame,
			controller
		)
	end

	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Emitter_" .. tostring(node.name)
	emitter.Enabled = false
	emitter.Texture = texture
	emitter.Lifetime = numberRange(lifeMin, lifeMax)
	emitter.Rate = 0
	emitter.Speed = numberRange(
		(node.transform.speed.min or 0) * unitScale * frameRate * speedScale,
		(node.transform.speed.max or 0) * unitScale * frameRate * speedScale
	)
	emitter.Acceleration = toVector3(node.transform.acceleration.center, unitScale * frameRate * frameRate)
	emitter.EmissionDirection = NORMAL_IDS[node.transform.emissionDirection] or Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(node.transform.spreadAngle or 0, node.transform.spreadAngle or 0)
	emitter.Color = colorSequence(node)
	emitter.Transparency = transparencySequence(node, lifeMax, frameRate)
	emitter.Size = sizeSequence(node, unitScale, particleSizeScale)
	emitter.LightEmission = blendLightEmission(node)
	emitter.LightInfluence = 0
	emitter.LockedToPart = false
	safeSet(emitter, "Orientation", particleOrientationForNode(node))
	emitter.Rotation = numberRange(
		rangeValue(node.transform.rotation.rotation, "min", 0),
		rangeValue(node.transform.rotation.rotation, "max", 0)
	)
	emitter.RotSpeed = numberRange(
		rangeValue(node.transform.rotation.speed, "min", 0) * frameRate,
		rangeValue(node.transform.rotation.speed, "max", 0) * frameRate
	)
	if node.rendererType == "Ring" then
		pcall(function()
			emitter.Shape = Enum.ParticleEmitterShape.Disc
		end)
		pcall(function()
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		end)
		safeSet(emitter, "Orientation", Enum.ParticleOrientation.FacingCamera)
	end
	if emitterParent:IsA("BasePart") then
		pcall(function()
			emitter.Shape = Enum.ParticleEmitterShape.Box
		end)
		pcall(function()
			emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		end)
	end
	emitter.Parent = emitterParent
	table.insert(controller._emitters, emitter)

	return emitter
end

local function createBeam(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller
): Beam?
	if not node.rendered or (node.rendererType ~= "Ribbon" and node.rendererType ~= "Track") then
		return nil
	end

	local frameRate = effect.frameRate or 60
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local visualScale = unitScale * particleSizeScale
	local lifeMax = math.max(1 / frameRate, rangeValue(node.life, "max", 100) / frameRate)
	local beamVisual = if node.visual then node.visual.beam else nil
	local baseSize = math.max(0.05, (node.transform.size.start or 1) * visualScale)
	local width = math.max(0.02, (if beamVisual then beamVisual.width * visualScale else baseSize))
	local length = math.max(width * 2, (if beamVisual then beamVisual.length * visualScale else baseSize * 8))
	local center = nodeCFrame(node, rootCFrame, unitScale)
	local half = length * 0.5

	local attachment0 = createAttachment(
		targetPart,
		"EffekseerBeam0_" .. tostring(node.id) .. "_" .. tostring(node.name),
		center * CFrame.new(-half, 0, 0),
		controller
	)
	local attachment1 = createAttachment(
		targetPart,
		"EffekseerBeam1_" .. tostring(node.id) .. "_" .. tostring(node.name),
		center * CFrame.new(half, 0, 0),
		controller
	)

	local beam = Instance.new("Beam")
	beam.Name = "Beam_" .. tostring(node.name)
	beam.Attachment0 = attachment0
	beam.Attachment1 = attachment1
	beam.Enabled = false
	beam.Width0 = width
	beam.Width1 = width
	beam.FaceCamera = true
	beam.Segments = 8
	beam.Color = colorSequence(node)
	beam.Transparency = transparencySequence(node, lifeMax, frameRate)
	beam.LightEmission = blendLightEmission(node)
	beam.LightInfluence = 0
	local texture = textureForNode(node, options, nil)
	if texture ~= "" then
		beam.Texture = texture
		beam.TextureLength = math.max(0.1, length)
		pcall(function()
			beam.TextureMode = Enum.TextureMode.Wrap
		end)
	end
	beam.Parent = targetPart
	table.insert(controller._instances, beam)
	table.insert(controller._beams, beam)

	return beam
end

local function createModelVisual(
	node: EffectNode,
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller
): BasePart?
	if not node.rendered or node.rendererType ~= "Model" then
		return nil
	end

	local unitScale = options.unitScale or effect.unitScale or 0.01
	local particleSizeScale = options.particleSizeScale or effect.particleSizeScale or 1
	local size = math.max(0.05, (node.transform.size.start or 1) * unitScale * particleSizeScale)
	local modelAsset = modelAssetForNode(node, options)
	local part: BasePart

	if modelAsset and modelAsset ~= "" then
		local ok, meshPart = pcall(function()
			local mesh = Instance.new("MeshPart")
			mesh.MeshId = modelAsset
			local texture = textureForNode(node, options, nil)
			if texture ~= "" then
				mesh.TextureID = texture
			end
			return mesh
		end)
		part = if ok then meshPart :: BasePart else Instance.new("Part")
	else
		part = Instance.new("Part")
		safeSet(part, "Shape", Enum.PartType.Ball)
	end

	part.Name = "Model_" .. tostring(node.name)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Material = if node.alphaBlend == 2 then Enum.Material.Neon else Enum.Material.SmoothPlastic
	part.Color = color3(node.color)
	part.Size = Vector3.new(size, size, size)
	part.Transparency = 1
	part.CFrame = targetPart.CFrame * nodeCFrame(node, rootCFrame, unitScale)
	part.Parent = targetPart

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = targetPart
	weld.Part1 = part
	weld.Parent = part

	table.insert(controller._instances, part)
	table.insert(controller._parts, part)

	return part
end

local function scheduleEmitter(
	node: EffectNode,
	emitter: ParticleEmitter,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local frameRate, maxGeneration, generationSeconds, offsetSeconds, nodeInfinite = visualTiming(
		node,
		effect,
		options,
		inheritedDelaySeconds
	)
	local burstTaskLimit = options.burstTaskLimit or 200
	local unitScale = options.unitScale or effect.unitScale or 0.01
	local rate = 1 / generationSeconds
	local cycleSeconds = if effectLoopEnabled(effect, options) then effectCycleSeconds(effect, frameRate) else nil
	local attachment = emitter.Parent
	local baseCFrame = if attachment and attachment:IsA("Attachment") then attachment.CFrame else CFrame.identity

	if nodeInfinite then
		repeatEveryCycle(controller, emitter, offsetSeconds, cycleSeconds, function(cycleOffset: number, activeCycleSeconds: number?)
			scheduleRateWindow(emitter, rate, nil, controller, cycleOffset, activeCycleSeconds)
		end)
		return
	end

	maxGeneration = math.max(0, maxGeneration)
	if maxGeneration <= burstTaskLimit then
		repeatEveryCycle(controller, emitter, offsetSeconds, cycleSeconds, function()
			emitBurstForNode(node, emitter, maxGeneration, generationSeconds, controller, baseCFrame, unitScale)
		end)
	else
		local duration = maxGeneration / rate
		repeatEveryCycle(controller, emitter, offsetSeconds, cycleSeconds, function()
			scheduleRateWindow(emitter, rate, duration, controller, nil, nil)
		end)
	end
end

local function visitNodes(
	nodes: { EffectNode },
	targetPart: BasePart,
	rootCFrame: CFrame,
	effect: EffectData,
	options: PlayOptions,
	controller,
	inheritedDelaySeconds: number?
)
	local unitScale = options.unitScale or effect.unitScale or 0.01
	for _, node in nodes do
		local fixedSpriteHandled = scheduleFixedSprite(
			node,
			targetPart,
			rootCFrame,
			effect,
			options,
			controller,
			inheritedDelaySeconds
		)
		local emitter = createParticleEmitter(node, targetPart, rootCFrame, effect, options, controller)
		if emitter then
			scheduleEmitter(node, emitter, effect, options, controller, inheritedDelaySeconds)
		end
		if not fixedSpriteHandled then
			local beam = createBeam(node, targetPart, rootCFrame, effect, options, controller)
			if beam then
				scheduleBeam(node, beam, effect, options, controller, inheritedDelaySeconds)
			end
			local model = createModelVisual(node, targetPart, rootCFrame, effect, options, controller)
			if model then
				schedulePart(node, model, effect, options, controller, inheritedDelaySeconds)
			end
		end
		visitNodes(
			node.children or {},
			targetPart,
			nodeCFrame(node, rootCFrame, unitScale),
			effect,
			options,
			controller,
			(inheritedDelaySeconds or 0) + nodeLocalDelay(node, effect)
		)
	end
end

function EffekseerPlayer.play(effect: EffectData, target: Instance, options: PlayOptions?)
	local playOptions: PlayOptions = options or {}

	local targetPart, rootCFrame = resolveTarget(target)
	if playOptions.hideTarget == true then
		targetPart.Transparency = 1
	end

	local controller = setmetatable({
		_alive = true,
		_instances = {},
		_emitters = {},
		_beams = {},
		_parts = {},
	}, Controller)

	visitNodes(effect.nodes, targetPart, rootCFrame, effect, playOptions, controller, 0)

	if playOptions.autoDestroy then
		local longest = 0
		local frameRate = effect.frameRate or 60
		local function scan(nodes: { EffectNode }, inheritedOffset: number)
			for _, node in nodes do
				local offset = inheritedOffset + rangeValue(node.generation.offset, "max", 0) / frameRate
				local generation = if node.generation.max == 0
					then 0
					else (node.generation.max or 1) * rangeValue(node.generation.time, "max", 1) / frameRate
				local life = rangeValue(node.life, "max", 100) / frameRate
				longest = math.max(longest, offset + generation + life)
				scan(node.children or {}, offset)
			end
		end
		scan(effect.nodes, 0)
		task.delay(longest, function()
			if controller._alive then
				controller:Destroy()
			end
		end)
	end

	return controller
end

return EffekseerPlayer
